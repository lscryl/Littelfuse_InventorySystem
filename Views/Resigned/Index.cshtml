}

/* ── Delete modal ── */
function openDeleteModal(data) {
    document.getElementById('deleteId').value  = data.id;
    document.getElementById('deleteTab').value = data.asset_status || 'resigned';
    document.getElementById('deleteMsg').textContent =
        'You are about to permanently delete the record for "' + (data.employee_name || '') + '".';
    openModal('deleteModal');
}

/* ── Back to Inventory ── */
function confirmBackToInventory(data) {
    document.getElementById('backToInvId').value = data.id;
    document.getElementById('backToInvMsg').textContent =
        'Return "' + (data.deployed_to || '') + '" back to inventory? This will reset the asset status to Resigned.';
    openModal('backToInvModal');
}

/* ── Record history modal ── */
function openRecordHistory(data) {
    document.getElementById('recHistModel').textContent  = data.model || data.employee_name || '—';
    document.getElementById('recHistSerial').textContent = data.serial_tag ? 'Serial: ' + data.serial_tag : '';
    document.getElementById('recHistScroll').innerHTML   = '<div class="rec-hist-loading">Loading history…</div>';
    openModal('recordHistoryModal');
    fetch(FETCH_HISTORY_URL + '?id=' + data.id)
        .then(r => r.json())
        .then(items => { document.getElementById('recHistScroll').innerHTML = buildTimelineHTML(items, false); })
        .catch(() => { document.getElementById('recHistScroll').innerHTML = '<div class="rec-hist-loading">Failed to load history.</div>'; });
}

/* ── Build Timeline HTML ── */
function buildTimelineHTML(items, showAsset) {
    if (!items || items.length === 0)
        return '<div class="history-empty">No history found.</div>';

    const groups = {};
    items.forEach(item => {
        const day = (item.created_at || '').split(' ')[0] || 'Unknown';
        if (!groups[day]) groups[day] = [];
        groups[day].push(item);
    });

    const dotCls = action => {
        const a = (action || '').toLowerCase().replace(/\s+/g, '');
        if (a.includes('created'))   return 'created';
        if (a.includes('edited'))    return 'edited';
        if (a.includes('deployed'))  return 'deployed';
        if (a.includes('inventory')) return 'backtoinventory';
        if (a.includes('deleted'))   return 'deleted';
        return 'default';
    };

    let html = '<div class="timeline">';
    Object.entries(groups).forEach(([day, dayItems]) => {
        html += '<div class="tl-date-group"><div class="tl-date-label">' + day + '</div>';
        dayItems.forEach(item => {
            const dc   = dotCls(item.action);
            const time = (item.created_at || '').split(' ')[1] || '';
            let assetHtml = '';
            if (showAsset && item.employee_name) {
                assetHtml = '<div class="tl-meta" style="margin-top:5px;"><div class="tl-asset-info">'
                    + '<span class="tl-asset-label">' + esc(item.employee_name) + '</span>'
                    + (item.model      ? '<span class="tl-asset-sub">' + esc(item.model)      + '</span>' : '')
                    + (item.serial_tag ? '<span class="tl-asset-sub">' + esc(item.serial_tag) + '</span>' : '')
                    + '</div></div>';
            }
            let actorHtml = '';
            if (item.actor) {
                actorHtml = '<div class="tl-actor"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">'
                    + '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'
                    + '</svg>' + esc(item.actor) + '</div>';
            }
            html += '<div class="tl-item">'
                + '<div class="tl-dot ' + dc + '"></div>'
                + '<div class="tl-top"><div>'
                + '<span class="tl-action-badge ' + dc + '">' + esc(item.action) + '</span>'
                + assetHtml + actorHtml
                + '</div><span class="tl-time">' + time + '</span></div>'
                + (item.details ? '<div class="tl-details">' + esc(item.details) + '</div>' : '')
                + '</div>';
        });
        html += '</div>';
    });
    html += '</div>';
    return html;
}

function esc(str) {
    return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

/* ── Get row data from nearest tr[data-row] ── */
function getRowData(el) {
    const tr = el.closest('tr[data-row]');
    return tr ? JSON.parse(tr.dataset.row) : {};
}

/* ── Toast ── */
@if (!string.IsNullOrEmpty(Model.ToastMsg))
{
    <text>
(function () {
    const toast = document.getElementById('toastNotif');
    const type  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ToastType));
    toast.classList.add('toast-' + type);
    document.getElementById('toastMsg').textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ToastMsg));
    document.getElementById('toastIcon').innerHTML  = type === 'success'
        ? '<path d="M20 6 9 17l-5-5"/>'
        : '<path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>';
    setTimeout(() => toast.classList.add('show'), 100);
    setTimeout(() => toast.classList.remove('show'), 3500);
})();
    </text>
}
</script>

@* History tab functions — only emitted on history tab *@
@if (isHist)
{
<script>
let allHistoryItems  = [];
let histFilterActive = 'all';
let histSearchActive = '';
function loadAllHistory() {
    fetch(FETCH_ALL_HIST_URL)
        .then(r => r.json())
        .then(items => { allHistoryItems = items; renderHistoryTab(); })
        .catch(() => { document.getElementById('historyScrollArea').innerHTML = '<div class="history-empty">Failed to load history.</div>'; });
}
function filterHistory(q) { histSearchActive = q.toLowerCase(); renderHistoryTab(); }
function setHistFilter(filter, btn) {
    histFilterActive = filter;
    document.querySelectorAll('#histFilterRow .hf-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderHistoryTab();
}
function renderHistoryTab() {
    let items = allHistoryItems;
    if (histFilterActive !== 'all') items = items.filter(i => i.action === histFilterActive);
    if (histSearchActive) items = items.filter(i =>
        [i.action, i.actor, i.details, i.employee_name, i.model, i.serial_tag].join(' ').toLowerCase().includes(histSearchActive));
    document.getElementById('historyScrollArea').innerHTML = buildTimelineHTML(items, true);
}
document.addEventListener('DOMContentLoaded', loadAllHistory);
</script>
}

@* Pagination — only emitted on non-history tabs *@
@if (!isHist)
{
<script>
const PAGE_SIZE = 50;
let currentPage = 1, currentQuery = '';
function liveSearch(query) { currentQuery = query.toLowerCase(); currentPage = 1; renderTable(); }
function renderTable() {
    const allRows  = Array.from(document.querySelectorAll('#resTable tbody tr:not(.empty-row)'));
    const filtered = allRows.filter(row => {
        const m = row.textContent.toLowerCase().includes(currentQuery);
        row.style.display = 'none';
        return m;
    });
    document.querySelectorAll('#resTable tbody tr.empty-row').forEach(r => r.remove());
    if (filtered.length === 0) {
        const tr = document.createElement('tr');
        tr.className = 'empty-row';
        tr.innerHTML = '<td colspan="7">No records match your search.</td>';
        document.querySelector('#resTable tbody').appendChild(tr);
        document.getElementById('paginationBar').style.display = 'none';
        return;
    }
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const end   = Math.min(start + PAGE_SIZE, filtered.length);
    filtered.forEach((row, i) => { row.style.display = (i >= start && i < end) ? '' : 'none'; });
    document.getElementById('paginationInfo').textContent =
        'Showing ' + (start + 1) + '–' + end + ' of ' + filtered.length + ' record' + (filtered.length !== 1 ? 's' : '');
    document.getElementById('paginationBar').style.display = 'flex';
    const btns = document.getElementById('paginationBtns');
    btns.innerHTML = '';
    const prev = document.createElement('button');
    prev.className = 'page-btn'; prev.disabled = currentPage === 1;
    prev.innerHTML = '<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>';
    prev.onclick = () => { currentPage--; renderTable(); };
    btns.appendChild(prev);
    getPageRange(currentPage, totalPages).forEach(p => {
        const btn = document.createElement('button');
        btn.className = 'page-btn' + (p === currentPage ? ' active' : '');
        if (p === '...') { btn.disabled = true; btn.textContent = '…'; }
        else { btn.textContent = p; btn.onclick = () => { currentPage = p; renderTable(); }; }
        btns.appendChild(btn);
    });
    const next = document.createElement('button');
    next.className = 'page-btn'; next.disabled = currentPage === totalPages;
    next.innerHTML = '<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>';
    next.onclick = () => { currentPage++; renderTable(); };
    btns.appendChild(next);
}
function getPageRange(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages = [1];
    if (current > 3) pages.push('...');
    for (let p = Math.max(2, current - 1); p <= Math.min(total - 1, current + 1); p++) pages.push(p);
    if (current < total - 2) pages.push('...');
    pages.push(total);
    return pages;
}
document.addEventListener('DOMContentLoaded', renderTable);
</script>
}
}
