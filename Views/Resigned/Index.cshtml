                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div id="importResStep1">
                <p style="font-size:.78rem;color:#666;margin-bottom:14px;">Upload a CSV file. The <strong>employee_name</strong> column is required; all others are optional.</p>
                <div style="background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.7rem;color:#555;line-height:1.9;">
                    <strong style="color:#333;">Required:</strong> employee_name<br>
                    <strong style="color:#333;">Optional:</strong> department, model, serial_tag, accessories, date_of_clearance, notes
                </div>
                <div style="margin-bottom:14px;">
                    <button type="button" onclick="downloadResignedTemplate()" style="display:inline-flex;align-items:center;gap:6px;font-size:.72rem;color:#25671E;padding:7px 14px;border:1.5px solid #c8e6c0;border-radius:8px;background:#f4fbf2;cursor:pointer;font-family:inherit;font-weight:600;">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download CSV Template
                    </button>
                </div>
                <label style="display:block;font-size:.7rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Select CSV File</label>
                <input type="file" id="importResFileInput" accept=".csv,text/csv" style="width:100%;padding:10px;border:1.5px solid #dde2ef;border-radius:8px;font-size:.78rem;font-family:inherit;background:#fff;cursor:pointer;">
                <p id="importResFileError" style="color:#c81e1e;font-size:.72rem;margin-top:6px;display:none;"></p>
            </div>
            <div id="importResStep2" style="display:none;">
                <div id="importResSummaryBar" style="display:flex;gap:10px;margin-bottom:14px;"></div>
                <div style="overflow-x:auto;max-height:300px;overflow-y:auto;border:1.5px solid #eef0f6;border-radius:10px;">
                    <table style="width:100%;border-collapse:collapse;min-width:500px;">
                        <thead><tr id="importResHead" style="position:sticky;top:0;background:#fff;z-index:1;"></tr></thead>
                        <tbody id="importResBody"></tbody>
                    </table>
                </div>
                <p style="font-size:.68rem;color:#aaa;margin-top:8px;">Rows with no employee name will be skipped.</p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="closeModal('importResignedModal')">Cancel</button>
            <button type="button" id="importResPreviewBtn" class="btn-submit" onclick="previewResignedImport()" style="display:none;">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Preview
            </button>
            <form method="post" action="/Resigned/ImportRecords" id="importResSubmitForm" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rows_json" id="importResRowsJson">
                <button type="submit" id="importResSubmitBtn" class="btn-submit">Import</button>
            </form>
        </div>
    </div>
</div>

@* ══ TOAST ══ *@
<div class="toast" id="toastNotif">
    <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" id="toastIcon"></svg>
    <span id="toastMsg"></span>
</div>

@section Scripts {
<script>

/* ── Export Resigned CSV ── */
function exportResignedCSV() {
    const rows = [['Employee Name','Department','Model','Serial Tag','Accessories','Date of Clearance','Notes','Status']];
    document.querySelectorAll('#resTable tbody tr:not(.empty-row)').forEach(tr => {
        if (tr.style.display === 'none') return;
        try {
            const data = JSON.parse(tr.dataset.row);
            rows.push([
                csvCell(data.employee_name),
                csvCell(data.department),
                csvCell(data.model),
                csvCell(data.serial_tag),
                csvCell(data.accessories),
                csvCell(data.date_of_clearance),
                csvCell(data.notes),
                csvCell(data.asset_status)
            ]);
        } catch(e) {}
    });
    triggerCSVDownload(rows, 'resigned_export.csv');
}

function csvCell(v) {
    const s = String(v || '');
    return (s.includes(',') || s.includes('"') || s.includes('\n'))
        ? '"' + s.replace(/"/g, '""') + '"' : s;
}
function triggerCSVDownload(rows, filename) {
    const csv  = rows.map(r => r.join(',')).join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url);
}

/* ── Import Resigned ── */
let importResRows = [];

function openImportResignedModal() {
    importResRows = [];
    document.getElementById('importResStep1').style.display = '';
    document.getElementById('importResStep2').style.display = 'none';
    document.getElementById('importResPreviewBtn').style.display = 'none';
    document.getElementById('importResSubmitForm').style.display = 'none';
    document.getElementById('importResFileInput').value = '';
    document.getElementById('importResFileError').style.display = 'none';
    openModal('importResignedModal');
}

document.addEventListener('DOMContentLoaded', function () {
    const fi = document.getElementById('importResFileInput');
    if (fi) fi.addEventListener('change', function () {
        const errEl   = document.getElementById('importResFileError');
        const prevBtn = document.getElementById('importResPreviewBtn');
        errEl.style.display = 'none'; prevBtn.style.display = 'none';
        if (!this.files?.[0]) return;
        if (!this.files[0].name.toLowerCase().endsWith('.csv')) {
            errEl.textContent = 'Please select a .csv file.';
            errEl.style.display = 'block'; return;
        }
        prevBtn.style.display = '';
    });
});

function previewResignedImport() {
    const file = document.getElementById('importResFileInput').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function (e) {
        const parsed = parseCSV(e.target.result);
        if (parsed.length < 2) {
            document.getElementById('importResFileError').textContent = 'CSV appears empty or has no data rows.';
            document.getElementById('importResFileError').style.display = 'block'; return;
        }
        const headers  = parsed[0].map(h => h.trim().toLowerCase().replace(/\s+/g, '_'));
        const dataRows = parsed.slice(1);
        importResRows  = []; let skipped = 0;
        dataRows.forEach(row => {
            const obj = {}; headers.forEach((h, i) => { obj[h] = (row[i] || '').trim(); });
            if (!obj.employee_name) { skipped++; return; }
            importResRows.push(obj);
        });
        const ready = importResRows.length, total = dataRows.length;
        document.getElementById('importResStep1').style.display = 'none';
        document.getElementById('importResStep2').style.display = '';
        document.getElementById('importResPreviewBtn').style.display = 'none';
        document.getElementById('importResSubmitForm').style.display = '';
        document.getElementById('importResRowsJson').value = JSON.stringify(importResRows);
        document.getElementById('importResSubmitBtn').textContent = 'Import ' + ready + ' Record' + (ready !== 1 ? 's' : '');
        document.getElementById('importResSummaryBar').innerHTML =
            '<div style="flex:1;background:#f4fbf2;border:1.5px solid #c8e6c0;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#0e9a4a;">' + ready + '</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Ready to import</div></div>' +
            (skipped ? '<div style="flex:1;background:#fde8e8;border:1.5px solid #f5c2c2;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#c81e1e;">' + skipped + '</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Skipped</div></div>' : '') +
            '<div style="flex:1;background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#333;">' + total + '</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Total rows</div></div>';

        const cols    = ['employee_name','department','model','serial_tag','accessories','date_of_clearance','notes'];
        const clabels = ['Employee Name','Department','Model','Serial Tag','Accessories','Date of Clearance','Notes'];
        document.getElementById('importResHead').innerHTML =
            clabels.map(l => '<th style="text-align:left;padding:10px 14px;font-size:.63rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.04em;border-bottom:1.5px solid #eef0f6;white-space:nowrap;">' + l + '</th>').join('') +
            '<th style="border-bottom:1.5px solid #eef0f6;"></th>';
        document.getElementById('importResBody').innerHTML =
            importResRows.slice(0, 50).map(r =>
                '<tr style="border-bottom:1px solid #f2f4fb;">' +
                cols.map(c => '<td style="padding:10px 14px;font-size:.73rem;color:#333;white-space:nowrap;">' + (r[c] || '<span style="color:#ccc;">—</span>') + '</td>').join('') +
                '<td style="padding:10px 14px;"><span style="background:#e3fbec;color:#0e9a4a;padding:3px 10px;border-radius:20px;font-size:.6rem;font-weight:700;">OK</span></td></tr>'
            ).join('') +
            (importResRows.length > 50 ? '<tr><td colspan="8" style="text-align:center;padding:10px;font-size:.7rem;color:#aaa;">… and ' + (importResRows.length - 50) + ' more rows</td></tr>' : '');
    };
    reader.readAsText(file);
}

function downloadResignedTemplate() {
    const csv = 'employee_name,department,model,serial_tag,accessories,date_of_clearance,notes\r\nJuan Dela Cruz,Accounting,Dell Latitude E7450,SN-00123,"Charger, Mouse",2025-06-01,Cleared all items\r\nMaria Santos,Engineering,HP EliteBook,SN-00456,,2025-06-05,\r\n';
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = 'resigned_import_template.csv'; a.click();
    URL.revokeObjectURL(url);
}

function parseCSV(text) {
    const rows = []; let cur = [], field = '', inQ = false;
    for (let i = 0; i < text.length; i++) {
        const c = text[i];
        if (inQ) { if (c === '"') { if (text[i+1] === '"') { field += '"'; i++; } else inQ = false; } else field += c; }
        else {
            if (c === '"') inQ = true;
            else if (c === ',') { cur.push(field); field = ''; }
            else if (c === '\n' || c === '\r') {
                if (c === '\r' && text[i+1] === '\n') i++;
                cur.push(field); field = '';
                if (cur.some(v => v.trim())) rows.push(cur); cur = [];
            } else field += c;
        }
    }
    if (field || cur.length) { cur.push(field); if (cur.some(v => v.trim())) rows.push(cur); }
    return rows;
}

const FETCH_HISTORY_URL  = '@Url.Action("FetchHistory","Resigned")';
const FETCH_ALL_HIST_URL = '@Url.Action("FetchAllHistory","Resigned")';

/* ── Dropdown ── */
function toggleDropdown(id, e) {
    e.stopPropagation();
    const menu = document.getElementById(id);
    const isOpen = menu.classList.contains('open');
    closeAllDropdowns();
    if (!isOpen) {
        const rect = e.currentTarget.getBoundingClientRect();
        const spaceB = window.innerHeight - rect.bottom;
        menu.style.right = (window.innerWidth - rect.right) + 'px';
        if (spaceB < 160) { menu.style.bottom = (window.innerHeight - rect.top + 4) + 'px'; menu.style.top = 'auto'; }
        else { menu.style.top = (rect.bottom + 4) + 'px'; menu.style.bottom = 'auto'; }
        menu.classList.add('open');
    }
}
function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
}
document.addEventListener('click', closeAllDropdowns);

/* ── Modal helpers ── */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.addEventListener('DOMContentLoaded', function () {
    // modal overlay click-outside
    document.querySelectorAll('.modal-overlay').forEach(el => {
        el.addEventListener('click', function (e) { if (e.target === this) closeModal(this.id); });
    });

    // clickable row → open view modal
    document.querySelectorAll('tr[data-row]').forEach(tr => {
        tr.addEventListener('click', function (e) {
            if (e.target.closest('.action-wrap')) return;
            const data = JSON.parse(this.dataset.row);
            if (data.asset_status === 'deployed') openDeployedView(data);
            else openViewModal(data);
        });
    });
});

/* ── Add modal ── */
function openAddModal() { openModal('addModal'); }

/* ── Edit modal ── */
function toggleDeployedFields(status) {
    const df = document.getElementById('deployedFields');
    const rs = document.getElementById('deployedToRequired');
    df.style.display = status === 'deployed' ? 'block' : 'none';
    if (rs) rs.style.display = status === 'deployed' ? 'inline' : 'none';
}
function openEditModal(data) {
    document.getElementById('editId').value            = data.id;
    document.getElementById('editEmployeeName').value  = data.employee_name;
    document.getElementById('editDepartment').value    = data.department        || '';
    document.getElementById('editModel').value         = data.model             || '';
    document.getElementById('editSerialTag').value     = data.serial_tag        || '';
    document.getElementById('editAccessories').value   = data.accessories       || '';
    document.getElementById('editDateClearance').value = data.date_of_clearance || '';
    document.getElementById('editNotes').value         = data.notes             || '';
    const status = data.asset_status || 'resigned';
    document.getElementById('editStatusSelect').value  = status;
    toggleDeployedFields(status);
    if (status === 'deployed') {
        document.getElementById('editDeployedTo').value    = data.deployed_to    || '';
        document.getElementById('editDeployedDept').value  = data.deployed_dept  || '';
        document.getElementById('editDeployedNotes').value = data.deployed_notes || '';
    }
    openModal('editModal');
}

/* ── View modal ── */
function openViewModal(data) {
    document.getElementById('viewEmpName').textContent = data.employee_name      || '—';
    document.getElementById('viewDept').textContent    = data.department         || '—';
    document.getElementById('viewDate').textContent    = data.date_of_clearance  || 'Not set';
    document.getElementById('viewModel').textContent   = data.model              || '—';
    document.getElementById('viewSerial').textContent  = data.serial_tag         || '—';
    document.getElementById('viewAcc').textContent     = data.accessories        || '—';
    document.getElementById('viewNotes').textContent   = data.notes              || '—';
    openModal('viewModal');
}

/* ── Deployed view modal ── */
function openDeployedView(data) {
    const initials = (data.deployed_to || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
    document.getElementById('dvAvatar').textContent        = initials;
    document.getElementById('dvCurrentUser').textContent   = data.deployed_to        || '—';
    document.getElementById('dvCurrentDept').textContent   = data.deployed_dept       || '—';
    document.getElementById('dvFormerUser').textContent    = data.employee_name       || '—';
    document.getElementById('dvFormerDept').textContent    = data.department          || '';
    document.getElementById('dvModel').textContent         = data.model               || '—';
    document.getElementById('dvSerial').textContent        = data.serial_tag          || '—';
    document.getElementById('dvDeployedAt').textContent    = data.deployed_at         || '—';
    document.getElementById('dvClearanceDate').textContent = data.date_of_clearance   || '—';
    document.getElementById('dvAccessories').textContent   = data.accessories         || '—';
    document.getElementById('dvDeployNotes').textContent   = data.deployed_notes      || '—';
    document.getElementById('dvNotes').textContent         = data.notes               || '—';
    openModal('deployedViewModal');
}

/* ── Deploy modal ── */
function openDeployModal(data) {
    document.getElementById('deployId').value                = data.id;
    document.getElementById('deployAssetModel').textContent  = data.model         || 'Unknown Model';
    document.getElementById('deployAssetSerial').textContent = data.serial_tag    ? 'Serial: ' + data.serial_tag : '';
    document.getElementById('deployAssetFormer').textContent = data.employee_name || '—';
    document.getElementById('deployEmployeeName').value      = '';
    document.getElementById('deployDepartment').value        = '';
