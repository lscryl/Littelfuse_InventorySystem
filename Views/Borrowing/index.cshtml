@* ============================================================
   File: Views/Borrowing/Index.cshtml
   Purpose: Main borrowing page with 3 tabs: Borrowed, Returned, Deployed.
            Converted from borrowing.php — preserves all UI and modals.
   ============================================================ *@

@model ITInventorySystem.Models.BorrowingViewModel

@{
    ViewData["Title"] = "Borrowing List";
    // Serialize items to JSON for JavaScript modal functions
    // Replaces PHP: json_encode($js_items) inline in onclick attributes
}

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Main ── */
    .main { flex: 1; padding: 24px 44px; overflow: hidden; display: flex; flex-direction: column; min-height: 0; height: 100vh; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-shrink: 0; border-bottom: 2px solid #e4e7f0; padding-bottom: 0; }
    .page-header h2 { font-size: 1.65rem; font-weight: 700; color: #111; padding-bottom: 12px; }
    .tabs-bar { display: flex; align-items: center; }
    .tab-btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; color: #888; background: none; border: none; border-bottom: 2.5px solid transparent; margin-bottom: -2px; cursor: pointer; text-decoration: none; white-space: nowrap; transition: color .18s, border-color .18s; }
    .tab-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
    .tab-btn:hover { color: #25671E; }
    .tab-btn.active { color: #25671E; border-bottom-color: #25671E; }
    .tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 18px; padding: 0 6px; border-radius: 9px; font-size: .62rem; font-weight: 700; background: #eef0f6; color: #777; transition: background .18s, color .18s; }
    .tab-btn.active .tab-count { background: #d6edcf; color: #1d5618; }

    /* ── Toolbar ── */
    .toolbar { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; flex-shrink: 0; }
    .search-wrap { flex: 1; position: relative; }
    .search-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #999; pointer-events: none; }
    .search-wrap input { width: 100%; padding: 11px 14px 11px 42px; border: 1.5px solid #dde2ef; border-radius: 10px; font-size: .75rem; background: #fff; color: #222; outline: none; transition: border-color .18s; font-family: 'Segoe UI', Arial, sans-serif; }
    .search-wrap input:focus { border-color: #25671E; }
    .btn-new { display: inline-flex; align-items: center; gap: 7px; background: #25671E; color: #fff; border: none; padding: 11px 22px; border-radius: 10px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; white-space: nowrap; transition: background .18s; }
    .btn-new:hover { background: #48A111; }
    .btn-export, .btn-import-open { display: inline-flex; align-items: center; gap: 7px; background: #fff; color: #444; border: 1.5px solid #dde2ef; padding: 11px 18px; border-radius: 10px; font-size: .75rem; font-weight: 600; cursor: pointer; white-space: nowrap; transition: background .18s, border-color .18s; }
    .btn-export:hover, .btn-import-open:hover { background: #f4f6fb; border-color: #c8cce0; }

    /* ── Table Card ── */
    .table-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 6px rgba(0,0,0,.07); display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }
    .table-scroll { overflow: auto; flex: 1; }
    table { width: 100%; border-collapse: collapse; min-width: 700px; }
    thead th { text-align: left; padding: 14px 18px; font-size: .65rem; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1.5px solid #eef0f6; background: #fff; position: sticky; top: 0; z-index: 1; }
    tbody tr { border-bottom: 1px solid #f2f4fb; transition: background .14s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f7f9ff; }
    td { padding: 16px 18px; font-size: .75rem; vertical-align: top; }
    .borrower-name { font-weight: 600; color: #111; }
    .dept { color: #777; font-size: .75rem; }
    .items-list { list-style: none; display: flex; flex-direction: column; gap: 5px; }
    .item-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .item-text { font-size: .75rem; color: #333; }
    .item-text.struck { text-decoration: line-through; color: #bbb; }
    .item-qty { color: #999; font-size: .75rem; }

    /* Badges */
    .badge { display: inline-block; padding: 4px 13px; border-radius: 20px; font-size: .6rem; font-weight: 600; letter-spacing: .02em; }
    .badge-Borrowed  { background: #e8f0fe; color: #1a56db; }
    .badge-Returned  { background: #e3fbec; color: #0e9a4a; }
    .badge-Overdue   { background: #fff3e0; color: #e65100; }
    .badge-Deployed  { background: #ede9fe; color: #6d28d9; }

    /* ── 3-dot dropdown ── */
    .action-wrap { position: relative; display: inline-block; }
    .btn-dots { background: none; border: none; cursor: pointer; padding: 6px 8px; border-radius: 6px; color: #666; display: inline-flex; align-items: center; justify-content: center; transition: background .15s, color .15s; }
    .btn-dots:hover { background: #eef0fb; color: #333; }
    .btn-dots svg { width: 18px; height: 18px; }
    .dropdown-menu { display: none; position: fixed; background: #fff; border: 1.5px solid #eef0f6; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.12); min-width: 170px; z-index: 200; overflow: hidden; animation: fadeIn .15s ease; }
    .dropdown-menu.open { display: block; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .dropdown-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: .65rem; font-weight: 500; color: #333; cursor: pointer; border: none; background: none; width: 100%; text-align: left; transition: background .13s; font-family: 'Segoe UI', Arial, sans-serif; }
    .dropdown-item:hover { background: #f4f6fb; }
    .dropdown-item svg { width: 15px; height: 15px; flex-shrink: 0; color: #666; }
    .dropdown-item.item-return { color: #1a56db; }
    .dropdown-item.item-return svg { color: #1a56db; }
    .dropdown-item.item-edit { color: #25671E; }
    .dropdown-item.item-edit svg { color: #25671E; }
    .dropdown-item.item-delete { color: #c81e1e; }
    .dropdown-item.item-delete svg { color: #c81e1e; }
    .dropdown-divider { height: 1px; background: #eef0f6; margin: 4px 0; }

    /* ── Pagination ── */
    .pagination-bar { display: none; align-items: center; justify-content: space-between; padding: 12px 18px; border-top: 1px solid #eef0f6; flex-shrink: 0; }
    .pagination-info { font-size: .72rem; color: #888; }
    .pagination-btns { display: flex; gap: 4px; }
    .page-btn { min-width: 32px; height: 32px; padding: 0 8px; border-radius: 7px; border: 1.5px solid #dde2ef; background: #fff; color: #555; font-size: .72rem; font-weight: 600; cursor: pointer; transition: background .15s, color .15s; display: inline-flex; align-items: center; justify-content: center; }
    .page-btn:hover:not(:disabled) { background: #f4f6fb; }
    .page-btn.active { background: #25671E; color: #fff; border-color: #25671E; }
    .page-btn:disabled { opacity: .4; cursor: default; }
    .page-btn svg { width: 14px; height: 14px; }
    .empty-row td { text-align: center; color: #aaa; padding: 40px; font-size: .8rem; }

    /* ── Modal ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 300; align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 16px; width: 560px; max-width: 96vw; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: slideUp .22s ease; }
    .modal-sm { width: 460px; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 24px 32px 16px; border-bottom: 1.5px solid #eef0f6; }
    .modal-header h3 { font-size: 1rem; font-weight: 700; color: #111; }
    .modal-close { background: none; border: none; cursor: pointer; color: #aaa; padding: 4px; border-radius: 6px; transition: color .15s; display: flex; }
    .modal-close:hover { color: #333; }
    .modal-close svg { width: 20px; height: 20px; }
    .modal-body { padding: 24px 32px 8px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .7rem; font-weight: 600; color: #555; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px 14px; border: 1.5px solid #dde2ef; border-radius: 8px; font-size: .78rem; font-family: 'Segoe UI', Arial, sans-serif; color: #222; background: #fafbff; outline: none; transition: border-color .18s; }
    .form-group input:focus, .form-group select:focus { border-color: #25671E; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .required { color: #c81e1e; margin-left: 2px; }
    .items-container { display: flex; flex-direction: column; gap: 8px; margin-bottom: 8px; }
    .item-row { display: grid; grid-template-columns: 1fr 90px 34px; gap: 8px; align-items: center; }
    .item-row input { margin: 0; }
    .btn-remove-item { background: none; border: 1.5px solid #fbbfbf; border-radius: 7px; color: #c81e1e; cursor: pointer; padding: 6px; display: flex; align-items: center; justify-content: center; transition: background .15s; }
    .btn-remove-item:hover { background: #fde8e8; }
    .btn-remove-item svg { width: 16px; height: 16px; }
    .btn-add-item { margin-top: 6px; background: none; border: 1.5px dashed #25671E; color: #25671E; border-radius: 8px; padding: 8px 14px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .15s; width: 100%; }
    .btn-add-item:hover { background: #e8f5e2; }
    .modal-footer { padding: 18px 32px 26px; display: flex; justify-content: flex-end; gap: 10px; }
    .btn-cancel { padding: 10px 22px; border-radius: 8px; border: 1.5px solid #dde2ef; background: #fff; color: #555; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .15s; }
    .btn-cancel:hover { background: #f4f6fb; }
    .btn-submit { padding: 10px 26px; border-radius: 8px; border: none; background: #25671E; color: #fff; font-size: .75rem; font-weight: 700; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .18s; }
    .btn-submit:hover { background: #48A111; }

    /* ── Return Modals ── */
    .return-modal { background: #fff; border-radius: 16px; width: 480px; max-width: 96vw; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: slideUp .22s ease; }
    .return-modal .modal-body { padding: 20px 28px 8px; }
    .return-subtitle { font-size: .75rem; color: #888; margin-bottom: 16px; }
    .received-by-box { background: #f4fbf2; border: 1.5px solid #c8e6c0; border-radius: 10px; padding: 14px 16px; margin-bottom: 18px; }
    .received-by-box label { display: flex; align-items: center; gap: 7px; font-size: .7rem; font-weight: 700; color: #25671E; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 8px; }
    .received-by-box label svg { width: 14px; height: 14px; flex-shrink: 0; }
    .received-by-box input { width: 100%; padding: 10px 13px; border: 1.5px solid #b8ddb4; border-radius: 8px; font-size: .78rem; font-family: 'Segoe UI', Arial, sans-serif; color: #222; background: #fff; outline: none; transition: border-color .18s; }
    .received-by-box input:focus { border-color: #25671E; }
    .return-item-list { display: flex; flex-direction: column; gap: 8px; }
    .return-item-row { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 10px; border: 1.5px solid #eef0f6; transition: border-color .15s, background .15s; cursor: pointer; }
    .return-item-row:hover:not(.is-returned) { border-color: #25671E; background: #f4fbf2; }
    .return-item-row.is-returned { background: #f8fffe; border-color: #d0f0e0; cursor: default; opacity: .7; }
    .return-item-row input[type="checkbox"] { width: 17px; height: 17px; accent-color: #25671E; flex-shrink: 0; cursor: pointer; }
    .return-item-info { flex: 1; }
    .return-item-name { font-size: .75rem; font-weight: 600; color: #111; }
    .return-item-name.struck { text-decoration: line-through; color: #aaa; }
    .return-item-qty { font-size: .7rem; color: #999; margin-top: 1px; }
    .tag-already-returned { font-size: .6rem; background: #e3fbec; color: #0e9a4a; padding: 2px 9px; border-radius: 10px; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
    .return-modal-footer { padding: 14px 28px 22px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .return-modal-footer .left { font-size: .75rem; color: #888; }
    .return-modal-footer .right { display: flex; gap: 10px; }
    .btn-return-selected { padding: 10px 22px; border-radius: 8px; border: none; background: #25671E; color: #fff; font-size: .75rem; font-weight: 700; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .18s; }
    .btn-return-selected:hover { background: #48A111; }
    .btn-return-selected:disabled { background: #b0c4b0; cursor: not-allowed; }

    /* ── Single Return Modal ── */
    .single-return-modal { background: #fff; border-radius: 16px; width: 420px; max-width: 96vw; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: slideUp .22s ease; }
    .single-return-modal .modal-body { padding: 22px 28px 10px; }
    .single-return-modal .modal-header { padding: 22px 28px 14px; border-bottom: 1.5px solid #eef0f6; display: flex; align-items: center; justify-content: space-between; }
    .single-return-modal .modal-footer { padding: 14px 28px 24px; display: flex; justify-content: flex-end; gap: 10px; }
    .return-confirm-info { background: #f4fbf2; border: 1.5px solid #c8e6c0; border-radius: 10px; padding: 13px 16px; margin-bottom: 18px; font-size: .78rem; color: #2a6e22; font-weight: 500; display: flex; align-items: center; gap: 10px; }
    .return-confirm-info svg { width: 16px; height: 16px; flex-shrink: 0; color: #25671E; }

    /* ── Delete Confirm ── */
    .confirm-modal { background: #fff; border-radius: 14px; width: 360px; max-width: 96vw; padding: 28px; box-shadow: 0 16px 48px rgba(0,0,0,.16); animation: slideUp .2s ease; text-align: center; }
    .confirm-modal .del-icon { width: 52px; height: 52px; border-radius: 50%; background: #fde8e8; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .confirm-modal .del-icon svg { width: 26px; height: 26px; color: #c81e1e; }
    .confirm-modal h3 { font-size: 1rem; font-weight: 700; color: #111; margin-bottom: 8px; }
    .confirm-modal p { font-size: .75rem; color: #666; margin-bottom: 22px; }
    .confirm-modal-btns { display: flex; justify-content: center; gap: 10px; }
    .btn-danger { padding: 10px 22px; border-radius: 8px; border: none; background: #c81e1e; color: #fff; font-size: .75rem; font-weight: 700; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .18s; }
    .btn-danger:hover { background: #a81818; }

    /* ── Return Details Modal ── */
    .details-modal { background: #fff; border-radius: 16px; width: 520px; max-width: 96vw; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: slideUp .22s ease; }
    .details-modal .modal-body { padding: 24px 32px 20px; }
    .detail-header-card { background: linear-gradient(135deg, #f4fbf2 0%, #e8f5e2 100%); border: 1.5px solid #c8e6c0; border-radius: 12px; padding: 20px 22px; margin-bottom: 22px; display: flex; align-items: center; gap: 16px; }
    .detail-avatar { width: 46px; height: 46px; border-radius: 50%; background: #25671E; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 700; flex-shrink: 0; }
    .detail-header-info { flex: 1; }
    .detail-name { font-size: .95rem; font-weight: 700; color: #111; }
    .detail-dept { font-size: .72rem; color: #666; margin-top: 2px; }
    .detail-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 22px; }
    .detail-meta-box { background: #f8f9fe; border: 1.5px solid #eef0f6; border-radius: 10px; padding: 13px 16px; }
    .detail-meta-box.full-width { grid-column: 1 / -1; }
    .detail-meta-label { font-size: .62rem; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
    .detail-meta-value { font-size: .78rem; font-weight: 600; color: #222; }
    .detail-meta-value.green { color: #0e9a4a; }
    .detail-meta-value.received { color: #1a56db; }
    .detail-section-title { font-size: .65rem; font-weight: 700; color: #999; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 10px; }
    .detail-items-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px; }
    .detail-item-row { display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; background: #f8f9fe; border: 1.5px solid #eef0f6; border-radius: 10px; }
    .detail-item-name { font-size: .78rem; font-weight: 600; color: #222; }
    .detail-item-qty { font-size: .72rem; color: #888; background: #eef0f6; padding: 2px 9px; border-radius: 8px; }
    .detail-returned-tag { font-size: .62rem; background: #e3fbec; color: #0e9a4a; padding: 3px 10px; border-radius: 8px; font-weight: 600; }
    .detail-modal-footer { padding: 16px 32px 26px; display: flex; justify-content: flex-end; }
    .device-cell { display: flex; align-items: center; gap: 7px; }
    .device-cell svg { width: 14px; height: 14px; color: #aaa; flex-shrink: 0; }

    /* ── Toast ── */
    .toast { position: fixed; bottom: 28px; right: 28px; display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 12px; background: #222; color: #fff; font-size: .78rem; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.18); z-index: 9999; transform: translateY(80px); opacity: 0; transition: transform .3s ease, opacity .3s ease; min-width: 240px; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast svg { width: 18px; height: 18px; flex-shrink: 0; }
    .toast-success { background: #1c6b34; }
    .toast-error   { background: #c81e1e; }

    .clickable-row {
    cursor: pointer;
}

.clickable-row:hover {
    background: #f4fbf2 !important;
}
</style>

<div class="main">
    <div class="page-header">
        <h2>🗒 Borrowing List</h2>
        <div class="tabs-bar">
            <a href="@Url.Action("Index", "Borrowing", new { tab = "borrowed" })"
               class="tab-btn @(Model.ActiveTab == "borrowed" ? "active" : "")">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 8h14M5 8a2 2 0 1 0 0-4h14a2 2 0 1 0 0 4M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/>
                </svg>
                Borrowed <span class="tab-count">@Model.CountBorrowed</span>
            </a>
            <a href="@Url.Action("Index", "Borrowing", new { tab = "returned" })"
               class="tab-btn @(Model.ActiveTab == "returned" ? "active" : "")">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="1 4 1 10 7 10"/>
                    <path d="M3.51 15a9 9 0 1 0 .49-4"/>
                </svg>
                Returned <span class="tab-count">@Model.CountReturned</span>
            </a>
            <a href="@Url.Action("Index", "Borrowing", new { tab = "deployed" })"
               class="tab-btn @(Model.ActiveTab == "deployed" ? "active" : "")">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                </svg>
                Deployed <span class="tab-count">@Model.CountDeployed</span>
            </a>
        </div>
    </div>

    <div class="toolbar">
        <div class="search-wrap">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="text" id="searchInput"
                   placeholder="@(Model.ActiveTab == "deployed" ? "Search by name, department, device, or serial..." : "Search by borrower, department, or item...")"
                   value="@Model.Search"
                   onkeyup="liveSearch(this.value)">
        </div>
        <button class="btn-export" onclick="exportCSV()">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export CSV
        </button>
        <button class="btn-import-open" onclick="openImportModal()">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            Import CSV
        </button>
        @if (Model.ActiveTab == "borrowed")
        {
            <button class="btn-new" onclick="openNewBorrowModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="18" height="18">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                New Borrow
            </button>
        }
        else if (Model.ActiveTab == "deployed")
        {
            <button class="btn-new" onclick="openNewDeploymentModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="18" height="18">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                New Deployment
            </button>
        }
    </div>

    <div class="table-card">
        <div class="table-scroll">

            @if (Model.ActiveTab == "deployed")
            {
                <table id="borrowTable">
                    <thead>
                        <tr>
                            <th>Date Deployed</th>
                            <th>Name</th>
                            <th>Department</th>
                            <th>Device</th>
                            <th>Serial No.</th>
                            <th>Deployed By</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Deployments.Any())
                        {
                            <tr class="empty-row"><td colspan="8">No deployment records found.</td></tr>
                        }
                        else
                        {
                    @foreach (var d in Model.Deployments)
                    {
                        var rowId = $"dropdown-deploy-{d.Id}";
                        var deployDetail = System.Text.Json.JsonSerializer.Serialize(new {
                            id            = d.Id,
                            name          = d.UserName      ?? "",
                            serial        = d.SerialNumber  ?? "",
                            dept          = d.Department    ?? "",
                            status        = d.Status        ?? "Deployed",
                            device        = d.DeviceName    ?? "",
                            deployed_by   = d.DeployedBy    ?? "",
                            date_deployed = d.DateDeployed  ?? ""
                        });

                        <tr class="clickable-row"
                            data-detail="@Html.Encode(deployDetail)"
                            onclick="openDeployDetails(this)">
                            <td>@d.DateDeployed</td>

                                    <td><div class="borrower-name">@d.UserName</div></td>
                                    <td><span class="dept">@(string.IsNullOrEmpty(d.Department) ? "—" : d.Department)</span></td>
                                    <td><div class="device-cell">@d.DeviceName</div></td>
                                    <td style="color:#555;">@(string.IsNullOrEmpty(d.SerialNumber) ? "—" : d.SerialNumber)</td>
                                    <td style="color:#555;">@(string.IsNullOrEmpty(d.DeployedBy) ? "—" : d.DeployedBy)</td>
<td><span class="badge @(d.Status == "Returned" ? "badge-Returned" : "badge-Deployed")">@d.Status</span></td>                                    <td>
                                        <div class="action-wrap">
                                            <button class="btn-dots" onclick="toggleDropdown('@rowId', event)" title="Actions">
                                                <svg fill="currentColor" viewBox="0 0 24 24">
                                                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu" id="@rowId">
                                            <button class="dropdown-item item-edit"
                                                                                    onclick="closeAllDropdowns(); openEditDeploymentModal(@d.Id, '@Html.Raw((d.UserName ?? "").Replace("'","\\\'"))', '@Html.Raw((d.SerialNumber ?? "").Replace("'","\\\'"))', '@Html.Raw((d.Department ?? "").Replace("'","\\\'"))', '@Html.Raw((d.DeviceName ?? "").Replace("'","\\\'"))', '@d.DateDeployed', '@Html.Raw((d.DeployedBy ?? "").Replace("'","\\\'"))', '@(d.Status ?? "Deployed")')">                                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                        </svg>
                                        Edit Entry
                                    </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item item-delete"
                                                        onclick="closeAllDropdowns(); openDeleteDeployModal(@d.Id, '@Html.Raw((d.UserName ?? "").Replace("'","\\\'"))')">                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                        <polyline points="3 6 5 6 21 6"/>
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                        <path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                                                    </svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table id="borrowTable">
                    <thead>
                        <tr>
                            <th>Date Borrowed</th>
                            <th>Borrower Name</th>
                            <th>Department</th>
                            <th>@(Model.ActiveTab == "returned" ? "Items Returned" : "Items Borrowed")</th>
                            <th>Serial No.</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Borrowings.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="7">@(Model.ActiveTab == "returned" ? "No returned records found." : "No active borrowing records found.")</td>
                            </tr>
                        }
                        else
                        {
@foreach (var b in Model.Borrowings)
{
    var rowId       = $"dropdown-{b.Id}";
    var badgeCls    = $"badge-{b.DisplayStatus}";
    var jsItems     = System.Text.Json.JsonSerializer.Serialize(
        b.Items.Where(i => i.ItemName.Trim() != "")
               .Select(i => new { id = i.Id, name = i.ItemName, qty = i.Quantity, status = i.Status }));
    var jsItemPairs = b.Items.Any(i => i.ItemName.Trim() != "")
        ? System.Text.Json.JsonSerializer.Serialize(
            b.Items.Where(i => i.ItemName.Trim() != "")
                   .Select(i => new[] { i.ItemName, i.Quantity.ToString() }))
        : "[]";
    var rowDetail = System.Text.Json.JsonSerializer.Serialize(new {
        id            = b.Id,
        name          = b.BorrowerName,
        serial        = b.SerialNumber  ?? "",
        dept          = b.Department    ?? "",
        status        = b.DisplayStatus,
        date_borrowed = b.DateBorrowed,
        date_returned = b.DateReturned  ?? "",
        received_by   = b.ReceivedBy    ?? "",
        items         = b.Items.Where(i => i.ItemName.Trim() != "")
                               .Select(i => new { id = i.Id, name = i.ItemName, qty = i.Quantity, status = i.Status })
    });

    <tr class="clickable-row"
        data-detail="@Html.Encode(rowDetail)"
        onclick="openRowDetails(this)">
        <td>@b.DateBorrowed</td>
        <td><div class="borrower-name">@b.BorrowerName</div></td>
        <td><span class="dept">@b.Department</span></td>
        <td>
            <ul class="items-list">
                @foreach (var item in b.Items.Where(i => i.ItemName.Trim() != ""))
                {
                    var struck = (item.Status == "Returned" && Model.ActiveTab == "borrowed") ? "struck" : "";
                    <li>
                        <div class="item-line">
                            <span class="item-text @struck">
                                @item.ItemName
                                <span class="item-qty"> x@(item.Quantity)</span>
                            </span>
                        </div>
                    </li>
                }
            </ul>
        </td>
        <td style="color:#555;">@(string.IsNullOrEmpty(b.SerialNumber) ? "—" : b.SerialNumber)</td>
        <td><span class="badge @badgeCls">@b.DisplayStatus</span></td>
        <td>
            <div class="action-wrap">
                <button class="btn-dots" onclick="toggleDropdown('@rowId', event)" title="Actions">
                    <svg fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>
                <div class="dropdown-menu" id="@rowId">
                    @if (Model.ActiveTab == "borrowed" && !b.AllReturned)
                    {
                        <button class="dropdown-item item-return"
                            data-id="@b.Id"
                            data-multi="@(b.IsMulti ? "true" : "false")"
                            data-name="@Html.Encode(b.BorrowerName)"
                            data-items="@Html.Encode(jsItems)"
                            onclick="closeAllDropdowns(); handleReturnBtn(this)">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/>
                                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"/>
                            </svg>
                            Mark as Returned
                        </button>
                        <div class="dropdown-divider"></div>
                    }
                    <button class="dropdown-item item-edit"
                        data-id="@b.Id"
                        data-name="@Html.Encode(b.BorrowerName)"
                        data-serial="@Html.Encode(b.SerialNumber)"
                        data-dept="@Html.Encode(b.Department)"
                        data-date="@(b.DateBorrowed.Length > 10 ? b.DateBorrowed.Substring(0,10) : b.DateBorrowed)"
                        data-status="@b.Status"
                        data-items="@Html.Encode(jsItemPairs)"
                        onclick="closeAllDropdowns(); openEditModalBtn(this)">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Edit Entry
                    </button>
                    <button class="dropdown-item item-delete"
                        onclick="closeAllDropdowns(); openDeleteModal(@b.Id, '@Html.Raw(b.BorrowerName.Replace("'","\\\'"))', '@Model.ActiveTab')">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                        Delete
                    </button>
                </div>
            </div>
        </td>
    </tr>
}
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="pagination-bar" id="paginationBar">
            <span class="pagination-info" id="paginationInfo"></span>
            <div class="pagination-btns" id="paginationBtns"></div>
        </div>
    </div>
</div>



