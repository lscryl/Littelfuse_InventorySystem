@section Scripts {
<script>
/* ── Dropdown ── */
function toggleDropdown(id, e) {
    e.stopPropagation();
    const menu = document.getElementById(id);
    const isOpen = menu.classList.contains('open');
    closeAllDropdowns();
    if (!isOpen) {
        const btn = e.currentTarget;
        const rect = btn.getBoundingClientRect();
        const spaceB = window.innerHeight - rect.bottom;
        menu.style.right = (window.innerWidth - rect.right) + 'px';
        if (spaceB < 160) { menu.style.bottom = (window.innerHeight - rect.top + 4) + 'px'; menu.style.top = 'auto'; }
        else { menu.style.top = (rect.bottom + 4) + 'px'; menu.style.bottom = 'auto'; }
        menu.classList.add('open');
    }
}
function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
}
document.addEventListener('click', closeAllDropdowns);

/* ── Modal helpers ── */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(el => {
    el.addEventListener('click', function(e) { if (e.target === this) closeModal(this.id); });
});

/* ── Deployment modals ── */
function openNewDeploymentModal() {
    document.getElementById('date_deployed_new').value = new Date().toISOString().split('T')[0];
    openModal('newDeploymentModal');
}
function openEditDeploymentModal(id, userName, serial, dept, deviceName, date, deployedBy = '', status = 'Deployed') {
    document.getElementById('editDeployId').value         = id;
    document.getElementById('editDeployUserName').value   = userName;
    document.getElementById('editDeploySerial').value     = serial;
    document.getElementById('editDeployDepartment').value = dept;
    document.getElementById('editDeployDeviceName').value = deviceName;
    document.getElementById('editDeployDate').value       = date;
    document.getElementById('editDeployDeployedBy').value = deployedBy;
    document.getElementById('editDeployStatus').value     = status;
    openModal('editDeploymentModal');
}
function openDeleteDeployModal(id, name) {
    document.getElementById('deleteDeployId').value = id;
    document.getElementById('deleteDeployMsg').textContent = 'You are about to delete the deployment for "' + name + '". This cannot be undone.';
    openModal('deleteDeployModal');
}

/* ── New borrow ── */
function openNewBorrowModal() {
    document.getElementById('date_borrowed').value = new Date().toISOString().split('T')[0];
    openModal('newBorrowModal');
}
function addItemRow() {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML = `<input type="text" name="items" placeholder="Item name" required><input type="number" name="items_qty" placeholder="Qty" min="1" value="1" required><button type="button" class="btn-remove-item" onclick="removeItemRow(this)"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button>`;
    document.getElementById('itemsContainer').appendChild(row);
}
function removeItemRow(btn) {
    if (document.querySelectorAll('#itemsContainer .item-row').length > 1)
        btn.closest('.item-row').remove();
}

/* ── Edit borrow modal ── */
function openEditModal(id, name, serial, dept, date, status, items) {
    document.getElementById('editId').value           = id;
    document.getElementById('editBorrowerName').value = name;
    document.getElementById('editSerialNumber').value = serial || '';
    document.getElementById('editDepartment').value   = dept  || '';
    // Ensure date is in yyyy-MM-dd format for <input type="date">
    document.getElementById('editDateBorrowed').value = date ? date.substring(0, 10) : '';
    document.getElementById('editStatus').value       = status || 'Borrowed';

    const container = document.getElementById('editItemsContainer');
    container.innerHTML = '';

    // items comes as array of [name, qty] pairs
    if (Array.isArray(items) && items.length > 0) {
        let added = 0;
        items.forEach(pair => {
            if (pair && pair[0] && String(pair[0]).trim() !== '') {
                addEditItemRow(String(pair[0]), pair[1] ?? 1);
                added++;
            }
        });
        // If nothing was added, add one empty row
        if (added === 0) addEditItemRow();
    } else {
        addEditItemRow();
    }

    openModal('editBorrowModal');
}

function addEditItemRow(itemName = '', qty = 1) {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML = `<input type="text" name="items" placeholder="Item name" value="${itemName}" required><input type="number" name="items_qty" placeholder="Qty" min="1" value="${qty}" required><button type="button" class="btn-remove-item" onclick="removeEditItemRow(this)"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg></button>`;
    document.getElementById('editItemsContainer').appendChild(row);
}
function removeEditItemRow(btn) {
    if (document.querySelectorAll('#editItemsContainer .item-row').length > 1)
        btn.closest('.item-row').remove();
}

/* ── Data-attribute wrapper for Mark as Returned button ── */
function handleReturnBtn(btn) {
    const id      = parseInt(btn.dataset.id);
    const isMulti = btn.dataset.multi === 'true';
    const name    = btn.dataset.name;
    // Html.Encode encodes & as &amp; — decode before parsing JSON
    const itemsJson = btn.dataset.items
        .replace(/&amp;/g, '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>');
    const items = JSON.parse(itemsJson || '[]');
    handleReturn(id, isMulti, name, items);
}

function openEditModalBtn(btn) {
    const id     = parseInt(btn.dataset.id);
    const name   = btn.dataset.name;
    const serial = btn.dataset.serial || '';
    const dept   = btn.dataset.dept   || '';
    const date   = btn.dataset.date   || '';
    const status = btn.dataset.status || 'Borrowed';

    const itemsJson = btn.dataset.items
        .replace(/&amp;/g, '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>');

    const items = JSON.parse(itemsJson || '[]');

    openEditModal(id, name, serial, dept, date, status, items);
}

/* ── Return logic ── */
let _returnBorrowId = null, _singleBorrowId = null;
function handleReturn(borrowId, isMulti, borrowerName, items) {
    if (!isMulti) {
        _singleBorrowId = borrowId;
        document.getElementById('singleReturnMsg').textContent = 'Mark the item as returned for ' + borrowerName + '?';
        document.getElementById('singleReceivedByInput').value = '';
        openModal('singleReturnModal'); return;
    }
    _returnBorrowId = borrowId;
    document.getElementById('returnSubtitle').textContent = 'Select which item(s) ' + borrowerName + ' has returned.';
    document.getElementById('multiReceivedByInput').value = '';
    const list = document.getElementById('returnItemList');
    list.innerHTML = '';
    items.forEach(item => {
        const isReturned = item.status === 'Returned';
        const row = document.createElement('label');
        row.className = 'return-item-row' + (isReturned ? ' is-returned' : '');
        const chk = document.createElement('input');
        chk.type = 'checkbox'; chk.value = item.id; chk.checked = false; chk.disabled = isReturned;
        chk.addEventListener('change', updateReturnCount);
        const info = document.createElement('div');
        info.className = 'return-item-info';
        info.innerHTML = `<div class="return-item-name${isReturned ? ' struck' : ''}">${escHtml(item.name)}</div><div class="return-item-qty">Qty: ${item.qty}</div>`;
        row.appendChild(chk); row.appendChild(info);
        if (isReturned) {
            const tag = document.createElement('span');
            tag.className = 'tag-already-returned'; tag.textContent = 'Already Returned';
            row.appendChild(tag);
        }
        list.appendChild(row);
    });
    updateReturnCount(); openModal('returnModal');
}
function submitSingleReturn() {
    const receivedBy = document.getElementById('singleReceivedByInput').value.trim();
    document.getElementById('returnAllBorrowId').value   = _singleBorrowId;
    document.getElementById('returnAllReceivedBy').value = receivedBy;
    document.getElementById('returnAllForm').submit();
}
function updateReturnCount() {
    const count = document.querySelectorAll('#returnItemList input[type="checkbox"]:checked').length;
    document.getElementById('returnSelectionCount').textContent = count + ' item(s) selected';
    document.getElementById('btnReturnSelected').disabled = count === 0;
}
function submitReturnSelected() {
    const checked = document.querySelectorAll('#returnItemList input[type="checkbox"]:checked');
    if (checked.length === 0) return;
    const receivedBy = document.getElementById('multiReceivedByInput').value.trim();

    // Check if ALL non-returned items are checked → use ReturnAll
    const totalBorrowedItems = document.querySelectorAll('#returnItemList input[type="checkbox"]:not(:disabled)').length;
    const checkedCount = checked.length;

    if (checkedCount >= totalBorrowedItems) {
        // All remaining items selected → mark whole borrow as returned
        document.getElementById('returnAllBorrowId').value   = _returnBorrowId;
        document.getElementById('returnAllReceivedBy').value = receivedBy;
        document.getElementById('returnAllForm').submit();
    } else {
        // Partial return → return first selected item
        document.getElementById('returnItemBorrowId').value   = _returnBorrowId;
        document.getElementById('returnItemId').value         = parseInt(checked[0].value);
        document.getElementById('returnItemReceivedBy').value = receivedBy;
        document.getElementById('returnItemForm').submit();
    }
}
function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── Details modal ── */
function openDetailsModal(data) {
    const initials = data.name.split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
    document.getElementById('detailAvatar').textContent       = initials;
    document.getElementById('detailName').textContent         = data.name;
    document.getElementById('detailDept').textContent         = data.dept || '—';
    document.getElementById('detailSerial').textContent       = data.serial || '—';
    document.getElementById('detailDeptBox').textContent      = data.dept || '—';
    document.getElementById('detailDateBorrowed').textContent = data.date_borrowed || '—';
    document.getElementById('detailDateReturned').textContent = data.date_returned || '—';
    document.getElementById('detailReceivedBy').textContent   = data.received_by || '—';
    const list = document.getElementById('detailItemsList');
    list.innerHTML = '';
    (data.items || []).forEach(item => {
        const row = document.createElement('div');
        row.className = 'detail-item-row';
        row.innerHTML = `<span class="detail-item-name">${escHtml(item.name)}</span><div style="display:flex;align-items:center;gap:8px;"><span class="detail-item-qty">x${item.qty}</span><span class="detail-returned-tag">Returned</span></div>`;
        list.appendChild(row);
    });
    openModal('detailsModal');
}

/* ── Delete modals ── */
function openDeleteModal(id, name, tab) {
    document.getElementById('deleteId').value  = id;
    document.getElementById('deleteTab').value = tab;
    document.getElementById('deleteMsg').textContent = 'You are about to delete the entry for "' + name + '". This cannot be undone.';
    openModal('deleteModal');
}

/* ── Pagination + Search ── */
const PAGE_SIZE = 50;
let currentPage = 1, currentQuery = '';
function liveSearch(query) { currentQuery = query.toLowerCase(); currentPage = 1; renderTable(); }
function renderTable() {
    const allRows = Array.from(document.querySelectorAll('#borrowTable tbody tr:not(.empty-row)'));
    const filtered = allRows.filter(row => {
        const match = row.textContent.toLowerCase().includes(currentQuery);
        row.style.display = 'none'; return match;
    });
    document.querySelectorAll('#borrowTable tbody tr.empty-row').forEach(r => r.remove());
    if (filtered.length === 0) {
        const tr = document.createElement('tr');
        tr.className = 'empty-row';
        const colCount = document.querySelectorAll('#borrowTable thead th').length;
tr.innerHTML = `<td colspan="${colCount}">No records match your search.</td>`;
        document.querySelector('#borrowTable tbody').appendChild(tr);
        document.getElementById('paginationBar').style.display = 'none'; return;
    }
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE, end = Math.min(start + PAGE_SIZE, filtered.length);
    filtered.forEach((row, i) => { row.style.display = (i >= start && i < end) ? '' : 'none'; });
    document.getElementById('paginationInfo').textContent = `Showing ${start + 1}–${end} of ${filtered.length} record${filtered.length !== 1 ? 's' : ''}`;
    document.getElementById('paginationBar').style.display = 'flex';
    const btns = document.getElementById('paginationBtns'); btns.innerHTML = '';
    const prev = document.createElement('button'); prev.className = 'page-btn'; prev.disabled = currentPage === 1;
    prev.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>`;
    prev.onclick = () => { currentPage--; renderTable(); }; btns.appendChild(prev);
    getPageRange(currentPage, totalPages).forEach(p => {
        const btn = document.createElement('button'); btn.className = 'page-btn' + (p === currentPage ? ' active' : '');
        if (p === '...') { btn.disabled = true; btn.textContent = '…'; }
        else { btn.textContent = p; btn.onclick = () => { currentPage = p; renderTable(); }; }
        btns.appendChild(btn);
    });
    const next = document.createElement('button'); next.className = 'page-btn'; next.disabled = currentPage === totalPages;
    next.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>`;
    next.onclick = () => { currentPage++; renderTable(); }; btns.appendChild(next);
}
function getPageRange(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages = [1];
    if (current > 3) pages.push('...');
    for (let p = Math.max(2, current - 1); p <= Math.min(total - 1, current + 1); p++) pages.push(p);
    if (current < total - 2) pages.push('...');
    pages.push(total); return pages;
}
document.addEventListener('DOMContentLoaded', renderTable);

/* ── Toast ── */
@if (!string.IsNullOrEmpty(Model.ToastMessage))
{
    <text>
    (function() {
        const toast = document.getElementById('toastNotif');
        const msgEl = document.getElementById('toastMsg');
        const iconEl = document.getElementById('toastIcon');
        const type = '@Model.ToastType';
        toast.classList.add('toast-' + type);
        msgEl.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ToastMessage));
        iconEl.innerHTML = type === 'success'
            ? '<path d="M20 6 9 17l-5-5"/>'
            : '<path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>';
        setTimeout(() => toast.classList.add('show'), 100);
        setTimeout(() => toast.classList.remove('show'), 3500);
    })();
    </text>
}

/* ── Row click → Details modal ── */
function openRowDetails(row) {
    // Prevent opening when clicking action buttons
    if (event.target.closest('.action-wrap')) return;

    const rawJson = row.dataset.detail
        .replace(/&amp;/g,  '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g,  "'")
        .replace(/&lt;/g,   '<')
        .replace(/&gt;/g,   '>');

    const data = JSON.parse(rawJson);

    // Badge styling
    const badgeEl = document.getElementById('rdBadge');
    badgeEl.textContent = data.status || '—';
    badgeEl.className   = 'badge badge-' + (data.status || 'Borrowed');

    // Avatar initials
    const initials = (data.name || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
    document.getElementById('rdAvatar').textContent       = initials;
    document.getElementById('rdTitle').textContent        = 'Borrow Details';
    document.getElementById('rdName').textContent         = data.name          || '—';
    document.getElementById('rdDept').textContent         = data.dept          || '—';
    document.getElementById('rdSerial').textContent       = data.serial        || '—';
    document.getElementById('rdDeptBox').textContent      = data.dept          || '—';
    document.getElementById('rdDateBorrowed').textContent = data.date_borrowed || '—';
    document.getElementById('rdDateReturned').textContent = data.date_returned || '—';
    document.getElementById('rdReceivedBy').textContent   = data.received_by   || '—';

    // Items list
    const list = document.getElementById('rdItemsList');
    list.innerHTML = '';
    (data.items || []).forEach(item => {
        const row = document.createElement('div');
        row.className = 'detail-item-row';
        const statusTag = item.status === 'Returned'
            ? '<span class="detail-returned-tag">Returned</span>'
            : '<span style="font-size:.62rem;background:#e8f0fe;color:#1a56db;padding:3px 10px;border-radius:8px;font-weight:600;">Borrowed</span>';
        row.innerHTML = `
            <span class="detail-item-name">${escHtml(item.name)}</span>
            <div style="display:flex;align-items:center;gap:8px;">
                <span class="detail-item-qty">x${item.qty}</span>
                ${statusTag}
            </div>`;
        list.appendChild(row);
    });

    openModal('rowDetailModal');
}

/* ── Deploy Row click → Details modal ── */
function openDeployDetails(row) {
    if (event.target.closest('.action-wrap')) return;

    const rawJson = row.dataset.detail
        .replace(/&amp;/g,  '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g,  "'")
        .replace(/&lt;/g,   '<')
        .replace(/&gt;/g,   '>');

    const data = JSON.parse(rawJson);

    const badgeEl = document.getElementById('rdBadge');
    badgeEl.textContent = data.status || 'Deployed';
    badgeEl.className   = 'badge badge-Deployed';

    const initials = (data.name || '?').split(' ').map(w => w[0]).join('').substring(0, 2).toUpperCase();
    document.getElementById('rdAvatar').textContent       = initials;
    document.getElementById('rdTitle').textContent        = 'Deployment Details';
    document.getElementById('rdName').textContent         = data.name        || '—';
    document.getElementById('rdDept').textContent         = data.dept        || '—';
    document.getElementById('rdSerial').textContent       = data.serial      || '—';
    document.getElementById('rdDeptBox').textContent      = data.dept        || '—';
    document.getElementById('rdDateBorrowed').textContent = data.date_deployed || '—';
    document.getElementById('rdDateReturned').textContent = '—';
    document.getElementById('rdReceivedBy').textContent   = data.deployed_by || '—';

    const list = document.getElementById('rdItemsList');
    list.innerHTML = '';
    const row2 = document.createElement('div');
    row2.className = 'detail-item-row';
    row2.innerHTML = `
    <span class="detail-item-name">${escHtml(data.device || '—')}</span>
    <div style="display:flex;align-items:center;gap:8px;">
        <span class="detail-returned-tag" style="background:#ede9fe;color:#6d28d9;">Deployed</span>
    </div>`;
    list.appendChild(row2);

    openModal('rowDetailModal');
}

/* ── Export CSV ── */
function exportCSV() {
    const tab = '@Model.ActiveTab';
    let headers, rows;

    if (tab === 'deployed') {
        headers = ['date_deployed','name','department','device','serial_number','deployed_by','status'];
        rows = [headers];
        document.querySelectorAll('#borrowTable tbody tr[data-detail]').forEach(tr => {
            if (tr.style.display === 'none') return;
            try {
                const d = JSON.parse(decodeDetail(tr.dataset.detail));
                rows.push([
                    csvCell(d.date_deployed), csvCell(d.name),       csvCell(d.dept),
                    csvCell(d.device),        csvCell(d.serial),      csvCell(d.deployed_by),
                    csvCell(d.status)
                ]);
            } catch(e) {}
        });
    } else {
        headers = ['date_borrowed','borrower_name','department','serial_number','status','date_returned','received_by','items'];
        rows = [headers];
        document.querySelectorAll('#borrowTable tbody tr[data-detail]').forEach(tr => {
            if (tr.style.display === 'none') return;
            try {
                const d = JSON.parse(decodeDetail(tr.dataset.detail));
                const itemsSummary = (d.items || []).map(i => i.name + ' x' + i.qty).join(' | ');
                rows.push([
                    csvCell(d.date_borrowed), csvCell(d.name),          csvCell(d.dept),
                    csvCell(d.serial),        csvCell(d.status),         csvCell(d.date_returned),
                    csvCell(d.received_by),   csvCell(itemsSummary)
                ]);
            } catch(e) {}
        });
    }

    const csv = rows.map(r => r.join(',')).join('\r\n');
    const a = document.createElement('a');
    a.href = 'data:text/csv,' + encodeURIComponent(csv);
    a.download = tab + '_export.csv';
    a.click();
}

function decodeDetail(str) {
    return str.replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>');
}
function csvCell(v) {
    const s = String(v || '');
    return (s.includes(',') || s.includes('"') || s.includes('\n')) ? '"' + s.replace(/"/g,'""') + '"' : s;
}

/* ── Import CSV ── */
var _importParsedRows = [], _importTab = '';
var _importCols = {
    borrowed: ['date_borrowed','borrower_name','department','serial_number','status','items'],
    returned: ['date_borrowed','borrower_name','department','serial_number','date_returned','received_by','items'],
    deployed: ['date_deployed','name','department','serial_number','device','deployed_by']
};
var _importHints = {
    borrowed: 'Required: <strong>borrower_name</strong>, <strong>date_borrowed</strong>. Optional: department, serial_number, status, items (format: "Item1 x2 | Item2 x1").',
    returned: 'Required: <strong>borrower_name</strong>, <strong>date_borrowed</strong>. Optional: department, serial_number, date_returned, received_by, items.',
    deployed: 'Required: <strong>name</strong>, <strong>date_deployed</strong>, <strong>device</strong>. Optional: department, serial_number, deployed_by.'
};
var _importActions = {
    borrowed: '/Borrowing/ImportBorrowed',
    returned: '/Borrowing/ImportReturned',
    deployed: '/Borrowing/ImportDeployed'
};

function openImportModal() {
    _importTab = '@Model.ActiveTab';
    document.getElementById('importTabLabel').textContent = _importTab.charAt(0).toUpperCase() + _importTab.slice(1);
    document.getElementById('importHint').innerHTML = (_importHints[_importTab] || '') + ' <a href="#" onclick="downloadImportTemplate();return false;" style="color:#25671E;font-weight:700;">Download template</a>';
    document.getElementById('importStep1').style.display = '';
    document.getElementById('importStep2').style.display = 'none';
    document.getElementById('importPreviewBtn').style.display = 'none';
    document.getElementById('importSubmitForm').style.display = 'none';
    document.getElementById('importFileInput').value = '';
    document.getElementById('importFileError').style.display = 'none';
    document.getElementById('importSubmitForm').action = _importActions[_importTab] || '/Borrowing/ImportBorrowed';
    document.getElementById('importTabInput').value = _importTab;
    _importParsedRows = [];
    openModal('importModal');
}

document.addEventListener('DOMContentLoaded', function() {
    const fi = document.getElementById('importFileInput');
    if (!fi) return;
    fi.addEventListener('change', function() {
        const errEl = document.getElementById('importFileError');
        const prevBtn = document.getElementById('importPreviewBtn');
        if (!this.files || !this.files[0]) { prevBtn.style.display = 'none'; return; }
        if (!this.files[0].name.toLowerCase().endsWith('.csv')) {
            errEl.textContent = 'Please select a .csv file.';
            errEl.style.display = 'block';
            prevBtn.style.display = 'none'; return;
        }
        errEl.style.display = 'none';
        prevBtn.style.display = '';
    });
});

function previewImport() {
    const file = document.getElementById('importFileInput').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
        const parsed = parseCSV(e.target.result);
        if (parsed.length < 2) {
            document.getElementById('importFileError').textContent = 'CSV is empty or has no data rows.';
            document.getElementById('importFileError').style.display = 'block'; return;
        }
        const headerRow = parsed[0].map(h => h.trim().toLowerCase().replace(/\s+/g,'_'));
        const dataRows  = parsed.slice(1);
        _importParsedRows = [];
        let skipped = 0;

        dataRows.forEach(function(row) {
            const obj = {};
            headerRow.forEach((h, i) => obj[h] = (row[i] || '').trim());

            // validate required fields per tab
            if (_importTab === 'deployed') {
                if (!obj.name || !obj.date_deployed || !obj.device) { skipped++; return; }
            } else {
                if (!obj.borrower_name || !obj.date_borrowed) { skipped++; return; }
            }
            if (!['Borrowed','Returned','Overdue'].includes(obj.status)) obj.status = 'Borrowed';
            _importParsedRows.push(obj);
        });

        // Show error if nothing parsed at all
        if (_importParsedRows.length === 0) {
            const errEl = document.getElementById('importFileError');
            errEl.innerHTML = 'No valid rows found. Make sure your CSV has the correct column headers.<br>'
                + '<strong>Detected headers:</strong> ' + headerRow.join(', ') + '<br>'
                + (skipped > 0 ? '<strong>' + skipped + ' row(s)</strong> were skipped due to missing required fields.' : '');
            errEl.style.display = 'block';
            return;
        }

        const cols = _importCols[_importTab] || [];
        document.getElementById('importStep1').style.display = 'none';
        document.getElementById('importStep2').style.display = '';
        document.getElementById('importPreviewBtn').style.display = 'none';
        document.getElementById('importSubmitForm').style.display = '';
        document.getElementById('importSubmitBtn').textContent = 'Import ' + _importParsedRows.length + ' Row(s)';
        document.getElementById('importRowsJson').value = JSON.stringify(_importParsedRows);
        document.getElementById('importSummaryBar').innerHTML =
            '<strong>' + _importParsedRows.length + '</strong> valid row(s) ready to import' +
            (skipped > 0 ? ' &nbsp;·&nbsp; <span style="color:#c81e1e;">' + skipped + ' skipped (missing required fields)</span>' : '');

        document.getElementById('importPreviewHead').innerHTML =
            '<tr>' + cols.map(c => '<th style="text-align:left;padding:8px 12px;font-size:.63rem;font-weight:700;color:#555;text-transform:uppercase;border-bottom:1.5px solid #eef0f6;background:#fff;">' + c + '</th>').join('') + '</tr>';

        document.getElementById('importPreviewBody').innerHTML =
            _importParsedRows.slice(0, 50).map(r =>
                '<tr>' + cols.map(c => '<td style="padding:8px 12px;font-size:.73rem;border-bottom:1px solid #f2f4fb;">' + escHtml(r[c] || '—') + '</td>').join('') + '</tr>'
            ).join('');
} catch(err) {
            document.getElementById('importFileError').textContent = 'Failed to parse CSV: ' + err.message;
            document.getElementById('importFileError').style.display = 'block';
        }
    };
reader.readAsText(file);
}

function parseCSV(text) {
    var rows=[],cur=[],field='',inQ=false;
    for(var i=0;i<text.length;i++){var c=text[i];
        if(inQ){if(c==='"'){if(text[i+1]==='"'){field+='"';i++;}else inQ=false;}else field+=c;}
        else{if(c==='"')inQ=true;else if(c===','){cur.push(field);field='';}
        else if(c==='\n'||c==='\r'){if(c==='\r'&&text[i+1]==='\n')i++;cur.push(field);field='';if(cur.some(v=>v.trim()))rows.push(cur);cur=[];}
        else field+=c;}}
    if(field||cur.length){cur.push(field);if(cur.some(v=>v.trim()))rows.push(cur);}
    return rows;
}

function downloadImportTemplate() {
    const templates = {
        borrowed: 'borrower_name,department,serial_number,date_borrowed,status,items\nJohn Smith,IT Department,SN-001,2024-01-15,Borrowed,Laptop x1 | Mouse x2\n',
        returned: 'borrower_name,department,serial_number,date_borrowed,date_returned,received_by,items\nJohn Smith,IT Department,SN-001,2024-01-15,2024-01-20,Maria Santos,Laptop x1\n',
        deployed: 'name,department,serial_number,device,date_deployed,deployed_by\nJohn Smith,Engineering,SN-001,Dell Latitude 7420,2024-01-15,Maria Santos\n'
    };
    const csv = templates[_importTab] || templates.borrowed;
    const a = document.createElement('a');
    a.href = 'data:text/csv,' + encodeURIComponent(csv);
    a.download = _importTab + '_import_template.csv';
    a.click();
}
</script>
