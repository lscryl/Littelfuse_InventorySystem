@* ════════════════════════════════════════════════════════════
   JAVASCRIPT
   ════════════════════════════════════════════════════════════ *@
<script>
/* ── Modal helpers ── */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.addEventListener('click', function(e) {
    document.querySelectorAll('.dropdown-menu.open').forEach(m => {
        if (!m.parentElement.contains(e.target)) m.classList.remove('open');
    });
});

/* ── Dropdown ── */
function toggleDropdown(btn, e) {
    e.stopPropagation();
    var menu = btn.nextElementSibling;
    var rect = btn.getBoundingClientRect();
    document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
    var menuWidth = 175;
    var left = rect.right - menuWidth;
    if (left < 8) left = rect.left;
    menu.style.top  = (rect.bottom + window.scrollY + 4) + 'px';
    menu.style.left = left + 'px';
    menu.classList.add('open');
}

/* ── Edit modal ── */
function openEditModal(el) {
    var p = JSON.parse(el.closest('tr').dataset.printer);
    document.getElementById('editId').value            = p.Id;
    document.getElementById('editName').value          = p.Name || '';
    document.getElementById('editVendor').value        = p.Vendor || '';
    document.getElementById('editModel').value         = p.Model || '';
    document.getElementById('editSerial').value        = p.Serial || '';
    document.getElementById('editBuilding').value      = p.Building || '';
    document.getElementById('editDepartment').value    = p.Department || '';
    document.getElementById('editIp').value            = p.IpAddress || '';
    document.getElementById('editMac').value           = p.MacAddress || '';
    document.getElementById('editStatus').value        = p.Status || 'Active';
    document.getElementById('editPulloutDate').value   = p.PulloutDate  ? p.PulloutDate.substring(0,16)  : '';
    document.getElementById('editReplacedDate').value  = p.ReplacedDate ? p.ReplacedDate.substring(0,16) : '';
    document.getElementById('editReplacedLocation').value = p.ReplacedLocation || '';
    document.getElementById('editRemarks').value       = p.Remarks || '';
    toggleEditConditional(p.Status || 'Active');
    closeAllDropdowns();
    openModal('editModal');
}

/* ── Replace modal ── */
function openReplaceModal(el) {
    var p = JSON.parse(el.closest('tr').dataset.printer);
    document.getElementById('replaceId').value = p.Id;
    document.getElementById('replaceDate').value = new Date().toISOString().substring(0,16);
    document.getElementById('replaceLocation').value = p.Building || '';
    closeAllDropdowns();
    openModal('replaceModal');
}

/* ── View details modal ── */
function openViewModal(el) {
    var p = JSON.parse(el.closest('tr').dataset.printer);
    var statusColors = { Active:'#0e9a4a', Pullout:'#e65100', Replaced:'#c81e1e' };
    var statusBg     = { Active:'#e3fbec', Pullout:'#fff3e0', Replaced:'#fde8e8' };
    var sc = statusColors[p.Status] || '#333';
    var sb = statusBg[p.Status]     || '#eee';
    var rows = [
        ['Building', p.Building], ['Department', p.Department],
        ['IP Address', p.IpAddress], ['MAC Address', p.MacAddress],
        ['Vendor', p.Vendor], ['Serial', p.Serial],
        ['Pullout Date', p.PulloutDate], ['Replaced Date', p.ReplacedDate],
        ['Replaced Location', p.ReplacedLocation], ['Added', p.CreatedAt],
    ];
    document.getElementById('viewContent').innerHTML =
        '<div style="background:linear-gradient(135deg,#f4fbf2,#e8f5e2);border:1.5px solid #c8e6c0;border-radius:12px;padding:18px 20px;margin-bottom:18px;display:flex;align-items:center;gap:14px;">' +
            '<div style="width:46px;height:46px;border-radius:12px;background:#25671E;display:flex;align-items:center;justify-content:center;">' +
                '<svg fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24" width="24" height="24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>' +
            '</div>' +
            '<div><div style="font-size:.95rem;font-weight:700;color:#111;">' + (p.Name||'') + '</div>' +
            '<div style="font-size:.73rem;color:#666;margin-top:3px;">' + (p.Model||'') + '</div>' +
            '<div style="margin-top:6px;"><span style="background:'+sb+';color:'+sc+';padding:3px 12px;border-radius:20px;font-size:.6rem;font-weight:700;">'+p.Status+'</span></div></div>' +
        '</div>' +
        '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">' +
        rows.map(function(r){ return r[1]
            ? '<div style="background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:11px 14px;">' +
              '<div style="font-size:.58rem;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">'+r[0]+'</div>' +
              '<div style="font-size:.8rem;font-weight:600;color:#222;">'+r[1]+'</div></div>' : '';
        }).join('') + '</div>' +
        (p.Remarks ? '<div style="margin-top:10px;background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:12px 14px;"><div style="font-size:.6rem;font-weight:700;color:#aaa;text-transform:uppercase;margin-bottom:4px;">Remarks</div><div style="font-size:.78rem;color:#555;line-height:1.6;">'+p.Remarks+'</div></div>' : '');
    openModal('viewModal');
}

/* ── Conditional fields ── */
function toggleAddConditional(v) {
    document.getElementById('addPulloutGroup').className  = 'conditional-group ' + (v === 'Pullout'   ? 'visible' : 'hidden');
    document.getElementById('addReplacedGroup').className = 'conditional-group ' + (v === 'Replaced'  ? 'visible' : 'hidden');
}
function toggleEditConditional(v) {
    document.getElementById('editPulloutGroup').className  = 'conditional-group ' + (v === 'Pullout'  ? 'visible' : 'hidden');
    document.getElementById('editReplacedGroup').className = 'conditional-group ' + (v === 'Replaced' ? 'visible' : 'hidden');
}

/* ── Delete ── */
function confirmDelete(id, name) {
    if (!confirm('Delete printer "' + name + '"?\nThis will also delete its history. This cannot be undone.')) return;
    document.getElementById('deleteId').value = id;
    document.getElementById('deleteForm').submit();
}

/* ── History (AJAX → /Printers/History/{id}) ── */
function loadHistory(printerId) {
    closeAllDropdowns();
    document.getElementById('historyContent').innerHTML = '<p style="color:#aaa;text-align:center;padding:24px;">Loading…</p>';
    openModal('historyModal');
    fetch('@Url.Action("History")/' + printerId)
        .then(r => r.json())
        .then(items => {
            if (!items.length) { document.getElementById('historyContent').innerHTML = '<p style="color:#aaa;text-align:center;padding:24px;">No history found.</p>'; return; }
            var html = '<div class="hist-timeline">';
            items.forEach(function(h, i) {
                var isLast = i === items.length - 1;
                var changes = [];
                var fields  = ['Name','Building','Dept','Ip','Mac','Model','Vendor','Serial','Status'];
                fields.forEach(function(f) {
                    var ov = h['Old' + f], nv = h['New' + f];
                    if (ov && nv && ov !== nv) changes.push('<strong>' + f + ':</strong> ' + ov + ' → ' + nv);
                });
                html += '<div class="hist-item">' +
                    '<div class="hist-dot-wrap"><div class="hist-dot"></div>' + (isLast ? '' : '<div class="hist-line"></div>') + '</div>' +
                    '<div class="hist-content">' +
                        '<div class="hist-event">' + h.EventType + '</div>' +
                        '<div class="hist-time">' + h.CreatedAt + '</div>' +
                        (changes.length ? '<div class="hist-details">' + changes.join('<br>') + '</div>' : '') +
                        (h.Remarks ? '<div class="hist-details" style="margin-top:4px;color:#888;"><em>' + h.Remarks + '</em></div>' : '') +
                    '</div></div>';
            });
            html += '</div>';
            document.getElementById('historyContent').innerHTML = html;
        })
        .catch(function() {
            document.getElementById('historyContent').innerHTML = '<p style="color:#c81e1e;text-align:center;padding:24px;">Failed to load history.</p>';
        });
}

function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
}

/* ── Search + Pagination ── */
const PAGE_SIZE = 50;
let currentPage = 1, currentQuery = '';
function liveSearch(q) { currentQuery = q.toLowerCase(); currentPage = 1; renderTable(); }
function renderTable() {
    var allRows = Array.from(document.querySelectorAll('#resTable tbody tr:not(.empty-row)'));
    var filtered = allRows.filter(r => { var m = r.textContent.toLowerCase().includes(currentQuery); r.style.display = 'none'; return m; });
    document.querySelectorAll('#resTable tbody tr.empty-row').forEach(r => r.remove());
    if (!filtered.length) {
        var tr = document.createElement('tr'); tr.className = 'empty-row';
        tr.innerHTML = '<td colspan="8">No printers match your search.</td>';
        document.querySelector('#resTable tbody').appendChild(tr);
        document.getElementById('paginationBar').style.display = 'none'; return;
    }
    var total = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > total) currentPage = total;
    var s = (currentPage - 1) * PAGE_SIZE, e = Math.min(s + PAGE_SIZE, filtered.length);
    filtered.forEach((r, i) => r.style.display = (i >= s && i < e) ? '' : 'none');
    document.getElementById('paginationInfo').textContent = 'Showing ' + (s+1) + '–' + e + ' of ' + filtered.length;
    document.getElementById('paginationBar').style.display = 'flex';
    var btns = document.getElementById('paginationBtns'); btns.innerHTML = '';
    var prev = document.createElement('button'); prev.className = 'page-btn'; prev.disabled = currentPage === 1;
    prev.innerHTML = '‹'; prev.onclick = () => { currentPage--; renderTable(); }; btns.appendChild(prev);
    for (var p = 1; p <= total; p++) {
        var b = document.createElement('button'); b.className = 'page-btn' + (p === currentPage ? ' active' : '');
        b.textContent = p; let pp = p; b.onclick = () => { currentPage = pp; renderTable(); }; btns.appendChild(b);
    }
    var next = document.createElement('button'); next.className = 'page-btn'; next.disabled = currentPage === total;
    next.innerHTML = '›'; next.onclick = () => { currentPage++; renderTable(); }; btns.appendChild(next);
}
document.addEventListener('DOMContentLoaded', renderTable);

/* ── Export CSV (client-side, same as PHP version) ── */
function exportCSV() {
    var keys    = ['Id','Name','Vendor','Model','Serial','Building','Department','IpAddress','MacAddress','Status','Remarks'];
    var headers = ['id','name','vendor','model','serial','building','department','ip_address','mac_address','status','remarks'];
    var rows = [headers];
    document.querySelectorAll('#resTable tbody tr[data-printer]').forEach(function(tr) {
        if (tr.style.display === 'none') return;
        try {
            var p = JSON.parse(tr.dataset.printer);
            rows.push(keys.map(k => csvCell(p[k] || '')));
        } catch(e) {}
    });
    var csv = rows.map(r => r.join(',')).join('\r\n');
    var a = document.createElement('a');
    a.href = 'data:text/csv,' + encodeURIComponent(csv);
    a.download = 'printers_export.csv'; a.click();
}

function csvCell(v) {
    var s = String(v);
    return (s.includes(',') || s.includes('"') || s.includes('\n')) ? '"' + s.replace(/"/g,'""') + '"' : s;
}

/* ── Import CSV ── */
var importParsedRows = [];
function openImportModal() {
    document.getElementById('importStep1').style.display = '';
    document.getElementById('importStep2').style.display = 'none';
    document.getElementById('importPreviewBtn').style.display = 'none';
    document.getElementById('importSubmitForm').style.display = 'none';
    document.getElementById('importFileInput').value = '';
    document.getElementById('importFileError').style.display = 'none';
    importParsedRows = [];
    openModal('importModal');
}
document.addEventListener('DOMContentLoaded', function() {
    var fi = document.getElementById('importFileInput');
    if (fi) fi.addEventListener('change', function() {
        var errEl = document.getElementById('importFileError');
        var prevBtn = document.getElementById('importPreviewBtn');
        if (!this.files || !this.files[0]) { prevBtn.style.display = 'none'; return; }
        if (!this.files[0].name.toLowerCase().endsWith('.csv')) {
            errEl.textContent = 'Please select a .csv file.'; errEl.style.display = 'block'; prevBtn.style.display = 'none'; return;
        }
        errEl.style.display = 'none'; prevBtn.style.display = '';
    });
});
function previewImport() {
    var file = document.getElementById('importFileInput').files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        var parsed = parseCSV(e.target.result);
        if (parsed.length < 2) { document.getElementById('importFileError').textContent = 'CSV is empty.'; document.getElementById('importFileError').style.display = 'block'; return; }
        var headerRow = parsed[0].map(h => h.trim().toLowerCase().replace(/\s+/g,'_'));
        var dataRows  = parsed.slice(1);
        importParsedRows = []; var skipped = 0;
        dataRows.forEach(function(row) {
            var obj = {}; headerRow.forEach((h,i) => obj[h] = (row[i]||'').trim());
            if (!obj.name) { skipped++; return; }
            if (!['Active','Pullout','Replaced'].includes(obj.status)) obj.status = 'Active';
            // map CSV snake_case keys to PascalCase for C# model binding
            obj.Name       = obj.name       || ''; 
            obj.Vendor     = obj.vendor     || '';
            obj.Model      = obj.model      || '';
            obj.Serial     = obj.serial     || '';
            obj.Building   = obj.building   || '';
            obj.Department = obj.department || '';
            obj.IpAddress  = obj.ip_address  || '';
            obj.MacAddress = obj.mac_address || '';
            obj.Status     = obj.status     || 'Active';
            obj.Remarks    = obj.remarks    || '';
            importParsedRows.push(obj);
        });
        document.getElementById('importStep1').style.display = 'none';
        document.getElementById('importStep2').style.display = '';
        document.getElementById('importPreviewBtn').style.display = 'none';
        document.getElementById('importSubmitForm').style.display = '';
        document.getElementById('importSubmitBtn').textContent = 'Import ' + importParsedRows.length + ' Printer(s)';
        document.getElementById('importRowsJson').value = JSON.stringify(importParsedRows);
        var cols = ['name','vendor','model','ip_address','building','department','status'];
        document.getElementById('importPreviewHead').innerHTML = cols.map(c => '<th style="text-align:left;padding:8px 12px;font-size:.63rem;font-weight:700;color:#555;text-transform:uppercase;border-bottom:1.5px solid #eef0f6;">'+c+'</th>').join('');
        document.getElementById('importPreviewBody').innerHTML = importParsedRows.slice(0,50).map(r =>
            '<tr><td colspan="' + cols.length + '" style="padding:8px 12px;font-size:.73rem;">' + cols.map(c => r[c]||'—').join(' | ') + '</td></tr>'
        ).join('');
    };
    reader.readAsText(file);
}
function parseCSV(text) {
    var rows=[],cur=[],field='',inQ=false;
    for(var i=0;i<text.length;i++){var c=text[i];
        if(inQ){if(c==='"'){if(text[i+1]==='"'){field+='"';i++;}else inQ=false;}else field+=c;}
        else{if(c==='"')inQ=true;else if(c===','){cur.push(field);field='';}
        else if(c==='\n'||c==='\r'){if(c==='\r'&&text[i+1]==='\n')i++;cur.push(field);field='';if(cur.some(v=>v.trim()))rows.push(cur);cur=[];}
        else field+=c;}}
    if(field||cur.length){cur.push(field);if(cur.some(v=>v.trim()))rows.push(cur);}
    return rows;
}
function downloadTemplate() {
    var csv = 'name,vendor,model,serial,building,department,ip_address,mac_address,status,remarks\r\nPrinter Lab 1,HP,LaserJet Pro M404n,VNC3R12345,Main Building,IT Department,192.168.1.101,00:1A:2B:3C:4D:5E,Active,\r\n';
    var a = document.createElement('a'); a.href = 'data:text/csv,' + encodeURIComponent(csv);
    a.download = 'printers_import_template.csv'; a.click();
}

/* ── Toast ── */
@if (!string.IsNullOrEmpty(Model.ToastMessage))
{
    <text>
    (function() {
        var toast = document.getElementById('toastNotif');
        var type  = '@Model.ToastType';
        toast.classList.add('toast-' + type);
        document.getElementById('toastMsg').textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ToastMessage));
        document.getElementById('toastIcon').innerHTML  = type === 'success'
            ? '<path d="M20 6 9 17l-5-5"/>'
            : '<path d="M12 9v4m0 4h.01"/>';
        setTimeout(() => toast.classList.add('show'), 100);
        setTimeout(() => toast.classList.remove('show'), 3500);
    })();
    </text>
}
</script>
