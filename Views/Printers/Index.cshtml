@* ============================================================
   Views/Printers/Index.cshtml
   Converted from printers.php — preserves all tabs, modals,
   search, pagination, export, import, and history timeline.

   PLACE THIS FILE AT:
     ITInventorySystem/Views/Printers/Index.cshtml
   ============================================================ *@

@model ITInventorySystem.Models.PrintersIndexViewModel
@{
    ViewData["Title"] = "Printers – IT Office Inventory";
    Layout = "_Layout";   @* remove this line if you have no shared layout yet *@
}

@* ── Inline styles (ported directly from printers.php) ── *@
<style>
    .main { flex:1; padding:24px 44px; overflow:hidden; display:flex; flex-direction:column; min-height:0; height:100vh; }
.table-card { flex:1; min-height:0; }
.table-scroll { flex:1; overflow:auto; }
    .page-header { display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:16px; border-bottom:2px solid #e4e7f0; padding-bottom:0; flex-shrink:0; }
.page-header h2 { font-size:1.65rem; font-weight:700; color:#111; padding-bottom:12px; }
    .tabs-bar { display:flex; align-items:center; }
    .tab-btn { display:inline-flex; align-items:center; gap:8px; padding:11px 22px; font-size:.75rem; font-weight:600; color:#888; background:none; border:none; border-bottom:2.5px solid transparent; margin-bottom:-2px; cursor:pointer; text-decoration:none; white-space:nowrap; transition:color .18s,border-color .18s; }
    .tab-btn:hover { color:#25671E; }
    .tab-btn.active { color:#25671E; border-bottom-color:#25671E; }
    .tab-count { display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:18px; padding:0 6px; border-radius:9px; font-size:.62rem; font-weight:700; background:#eef0f6; color:#777; }
    .tab-btn.active .tab-count { background:#d6edcf; color:#1d5618; }
    .toolbar { display:flex; align-items:center; gap:14px; margin-bottom:16px; }
    .search-wrap { flex:1; position:relative; }
    .search-wrap svg { position:absolute; left:14px; top:50%; transform:translateY(-50%); width:18px; height:18px; color:#999; pointer-events:none; }
    .search-wrap input { width:100%; padding:11px 14px 11px 42px; border:1.5px solid #dde2ef; border-radius:10px; font-size:.75rem; background:#fff; outline:none; transition:border-color .18s; }
    .search-wrap input:focus { border-color:#25671E; }
    .btn-new { display:inline-flex; align-items:center; gap:7px; background:#25671E; color:#fff; border:none; padding:11px 22px; border-radius:10px; font-size:.75rem; font-weight:600; cursor:pointer; white-space:nowrap; transition:background .18s; }
    .btn-new:hover { background:#48A111; }
    .btn-export,.btn-import-open { display:inline-flex; align-items:center; gap:7px; background:#fff; color:#444; border:1.5px solid #dde2ef; padding:11px 18px; border-radius:10px; font-size:.75rem; font-weight:600; cursor:pointer; white-space:nowrap; transition:background .18s,border-color .18s; }
    .btn-export:hover,.btn-import-open:hover { background:#f4f6fb; border-color:#c8cce0; }
    .table-card { background:#fff; border-radius:14px; box-shadow:0 1px 6px rgba(0,0,0,.07); display:flex; flex-direction:column; overflow:hidden; }
    .table-scroll { overflow:auto; }
    table { width:100%; border-collapse:collapse; min-width:1000px; }
    thead th { text-align:left; padding:14px 18px; font-size:.65rem; font-weight:700; color:#555; text-transform:uppercase; letter-spacing:.04em; border-bottom:1.5px solid #eef0f6; background:#fff; white-space:nowrap; }
    tbody tr { border-bottom:1px solid #f2f4fb; transition:background .14s; }
    tbody tr:hover { background:#f7f9ff; }
    td { padding:14px 18px; font-size:.75rem; vertical-align:middle; }
    .printer-name { font-weight:600; color:#111; }
    .printer-model { color:#777; font-size:.7rem; margin-top:2px; }
    .location-building { font-weight:600; color:#333; font-size:.75rem; }
    .location-dept { color:#999; font-size:.7rem; }
    .mono { font-size:.72rem; color:#445; background:#f8f9fe; padding:3px 8px; border-radius:5px; display:inline-block; }
    .badge { display:inline-block; padding:4px 13px; border-radius:20px; font-size:.6rem; font-weight:700; white-space:nowrap; }
    .badge-Active { background:#e3fbec; color:#0e9a4a; }
    .badge-Pullout { background:#fff3e0; color:#e65100; }
    .badge-Replaced { background:#fde8e8; color:#c81e1e; }
    .remarks-cell { max-width:160px; font-size:.7rem; color:#777; white-space:normal; line-height:1.4; }
    .remarks-none { color:#ccc; font-style:italic; }
    .empty-row td { text-align:center; padding:60px; color:#aaa; font-size:.95rem; }
    /* Dropdown */
    .action-wrap { position:relative; display:inline-block; }
    .btn-dots { background:none; border:none; cursor:pointer; padding:6px 8px; border-radius:6px; color:#666; display:inline-flex; align-items:center; transition:background .15s; }
    .btn-dots:hover { background:#eef0fb; }
    .btn-dots svg { width:18px; height:18px; }
    .dropdown-menu { display:none; position:fixed; background:#fff; border:1.5px solid #eef0f6; border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,.12); min-width:175px; z-index:200; overflow:hidden; }
    .dropdown-menu.open { display:block; }
    .dropdown-item { display:flex; align-items:center; gap:10px; padding:10px 16px; font-size:.68rem; font-weight:500; color:#333; cursor:pointer; border:none; background:none; width:100%; text-align:left; transition:background .13s; }
    .dropdown-item svg { width:15px; height:15px; color:#666; }
    .dropdown-item:hover { background:#f4f6fb; }
    .dropdown-item.item-replace { color:#b45309; }
    .dropdown-item.item-replace svg { color:#b45309; }
    .dropdown-item.item-replace:hover { background:#fffbeb; }
    .dropdown-item.item-history { color:#6366f1; }
    .dropdown-item.item-history:hover { background:#eef2ff; }
    .dropdown-item.item-delete { color:#c81e1e; }
    .dropdown-item.item-delete:hover { background:#fde8e8; }
    .dropdown-divider { height:1px; background:#eef0f6; margin:4px 0; }
    /* Pagination */
    .pagination-bar { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; border-top:1.5px solid #eef0f6; background:#fff; }
    .pagination-info { font-size:.72rem; color:#888; }
    .pagination-btns { display:flex; align-items:center; gap:4px; }
    .page-btn { min-width:32px; height:32px; padding:0 8px; border-radius:8px; border:1.5px solid #eef0f6; background:#fff; color:#555; font-size:.72rem; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition:background .15s; }
    .page-btn:hover:not(:disabled) { background:#f4f6fb; }
    .page-btn.active { background:#25671E; border-color:#25671E; color:#fff; }
    .page-btn:disabled { opacity:.35; cursor:not-allowed; }
    /* Toast */
    .toast { position:fixed; bottom:28px; right:28px; z-index:999; display:flex; align-items:center; gap:12px; padding:14px 20px; border-radius:12px; font-size:.88rem; font-weight:600; box-shadow:0 8px 28px rgba(0,0,0,.15); transform:translateY(80px); opacity:0; transition:transform .3s ease,opacity .3s ease; pointer-events:none; max-width:360px; }
    .toast.show { transform:translateY(0); opacity:1; pointer-events:auto; }
    .toast-success { background:#e3fbec; color:#0e9a4a; border:1.5px solid #b2f2cb; }
    .toast-error { background:#fde8e8; color:#c81e1e; border:1.5px solid #f5c2c2; }
    .toast svg { width:18px; height:18px; flex-shrink:0; }
    /* Modal */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(20,30,60,.45); z-index:100; align-items:center; justify-content:center; }
    .modal-overlay.open { display:flex; }
    .modal { background:#fff; border-radius:16px; width:720px; max-width:96vw; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.18); animation:slideUp .22s ease; }
    @@keyframes slideUp { from { transform:translateY(28px); opacity:0; } to { transform:translateY(0); opacity:1; } }
    .modal-header { display:flex; align-items:center; justify-content:space-between; padding:22px 30px 14px; border-bottom:1.5px solid #eef0f6; position:sticky; top:0; background:#fff; z-index:2; border-radius:16px 16px 0 0; }
    .modal-header h3 { font-size:1.1rem; font-weight:700; color:#111; }
    .modal-close { background:none; border:none; cursor:pointer; color:#888; padding:4px; border-radius:6px; display:inline-flex; transition:color .15s; }
    .modal-close:hover { color:#c81e1e; }
    .modal-close svg { width:20px; height:20px; }
    .modal-body { padding:22px 30px 10px; }
    .modal-footer { padding:14px 30px 22px; display:flex; justify-content:flex-end; gap:10px; border-top:1.5px solid #eef0f6; margin-top:6px; }
    /* Forms */
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .form-row-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; }
    .form-group { margin-bottom:14px; }
    .form-group.full { grid-column:1 / -1; }
    .form-group label { display:block; font-size:.7rem; font-weight:700; color:#555; text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; }
    .form-group input,.form-group select,.form-group textarea { width:100%; padding:10px 13px; border:1.5px solid #dde2ef; border-radius:8px; font-size:.78rem; color:#222; outline:none; background:#fff; transition:border-color .18s; }
    .form-group input:focus,.form-group select:focus,.form-group textarea:focus { border-color:#25671E; }
    .form-group textarea { resize:vertical; min-height:80px; }
    .required { color:#c81e1e; }
    .conditional-group.hidden { display:none; }
    .conditional-group.visible { display:block; }
    .form-section-title { font-size:.62rem; font-weight:700; color:#25671E; text-transform:uppercase; letter-spacing:.08em; margin:4px 0 12px; padding-bottom:8px; border-bottom:1.5px solid #e8f5e2; display:flex; align-items:center; gap:8px; }
    .form-section-title.amber { color:#b45309; border-bottom-color:#fde68a; }
    .btn-cancel { padding:10px 22px; border-radius:8px; border:1.5px solid #dde2ef; background:#fff; color:#555; font-size:.75rem; font-weight:600; cursor:pointer; transition:background .15s; }
    .btn-cancel:hover { background:#f4f6fb; }
    .btn-submit { padding:10px 26px; border-radius:8px; border:none; background:#25671E; color:#fff; font-size:.75rem; font-weight:700; cursor:pointer; transition:background .18s; }
    .btn-submit:hover { background:#48A111; }
    .btn-amber { padding:10px 22px; border-radius:8px; border:none; background:#b45309; color:#fff; font-size:.75rem; font-weight:700; cursor:pointer; transition:background .18s; display:inline-flex; align-items:center; gap:7px; }
    .btn-amber:hover { background:#92400e; }
    .btn-danger { padding:10px 22px; border-radius:8px; border:none; background:#c81e1e; color:#fff; font-size:.75rem; font-weight:700; cursor:pointer; transition:background .18s; }
    .btn-danger:hover { background:#a81818; }
    .new-printer-box { background:#fffbeb; border:1.5px solid #fde68a; border-radius:12px; padding:16px 18px; margin-bottom:14px; }
    /* Error box */
    .error-box { background:#fde8e8; border:1.5px solid #f5c2c2; border-radius:10px; padding:12px 16px; margin-bottom:16px; font-size:.78rem; color:#c81e1e; font-weight:600; }
    /* History timeline */
    .hist-timeline { display:flex; flex-direction:column; gap:12px; padding:4px 0; }
    .hist-item { display:flex; gap:12px; }
    .hist-dot-wrap { display:flex; flex-direction:column; align-items:center; }
    .hist-dot { width:10px; height:10px; border-radius:50%; background:#25671E; flex-shrink:0; margin-top:4px; }
    .hist-line { width:2px; flex:1; background:#eef0f6; margin-top:4px; }
    .hist-content { flex:1; padding-bottom:12px; }
    .hist-event { font-size:.78rem; font-weight:700; color:#111; }
    .hist-time { font-size:.65rem; color:#aaa; margin-top:2px; }
    .hist-details { font-size:.72rem; color:#555; margin-top:6px; background:#f8f9fe; border-radius:8px; padding:8px 12px; line-height:1.6; }
    /* Import */
    .import-modal { background:#fff; border-radius:16px; width:760px; max-width:96vw; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.18); }
    .drop-zone { border:2px dashed #dde2ef; border-radius:12px; padding:32px; text-align:center; cursor:pointer; transition:border-color .18s,background .18s; }
    .drop-zone:hover { border-color:#25671E; background:#f4fbf2; }
</style>

@* ── Page Header ── *@
<div class="main">
<div class="page-header">
    <h2>🖨 Printers</h2>
    <div class="tabs-bar">
        <a href="@Url.Action("Index", new { status = "" })"
           class="tab-btn @(Model.FilterStatus == "" ? "active" : "")">
            All <span class="tab-count">@Model.Counts.All</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Active" })"
           class="tab-btn @(Model.FilterStatus == "Active" ? "active" : "")">
            Active <span class="tab-count">@Model.Counts.Active</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Pullout" })"
           class="tab-btn @(Model.FilterStatus == "Pullout" ? "active" : "")">
            Pullout <span class="tab-count">@Model.Counts.Pullout</span>
        </a>
        <a href="@Url.Action("Index", new { status = "Replaced" })"
           class="tab-btn @(Model.FilterStatus == "Replaced" ? "active" : "")">
            Replaced <span class="tab-count">@Model.Counts.Replaced</span>
        </a>
    </div>
</div>

@* ── Error / Toast ── *@
@if (!string.IsNullOrEmpty(Model.SaveError))
{
    <div class="error-box">⚠ @Model.SaveError</div>
}

@* ── Toolbar ── *@
<div class="toolbar">
    <div class="search-wrap">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
        </svg>
        <input type="text" id="searchInput" placeholder="Search printers…"
               value="@Model.Search" oninput="liveSearch(this.value)">
    </div>
    <button class="btn-export" onclick="exportCSV()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Export CSV
    </button>
    <button class="btn-import-open" onclick="openImportModal()">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        Import CSV
    </button>
    <button class="btn-new" onclick="openModal('addModal')">
        <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="16" height="16">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add Printer
    </button>
</div>

@* ── Table ── *@
<div class="table-card">
    <div class="table-scroll">
        <table id="resTable">
            <thead>
                <tr>
                    <th>Printer / Model</th>
                    <th>Location</th>
                    <th>Vendor</th>
                    <th>IP Address</th>
                    <th>MAC Address</th>
                    <th>Status</th>
                    <th>Remarks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Printers.Any())
                {
                    <tr class="empty-row">
                        <td colspan="8">
                            <div class="empty-icon">
                                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                                    <path d="M8 21h8m-4-4v4"/>
                                </svg>
                            </div>
                            No printers found.
                        </td>
                    </tr>
                }
                @foreach (var p in Model.Printers)
                {
                    var pJson = System.Text.Json.JsonSerializer.Serialize(p);
                    <tr data-printer="@pJson" onclick="openViewModal(this)" style="cursor:pointer;">
                        <td>
                            <div class="printer-name">@p.Name</div>                            @if (!string.IsNullOrEmpty(p.Model))
                            {
                                <div class="printer-model">@p.Model</div>
                            }
                        </td>
                        <td>
                            <div class="location-building">@(string.IsNullOrEmpty(p.Building) ? "—" : p.Building)</div>
                            @if (!string.IsNullOrEmpty(p.Department))
                            {
                                <div class="location-dept">@p.Department</div>
                            }
                        </td>
                        <td>@(string.IsNullOrEmpty(p.Vendor) ? "—" : p.Vendor)</td>
                        <td>@(string.IsNullOrEmpty(p.IpAddress) ? "—" : p.IpAddress)</td>
                        <td>@(string.IsNullOrEmpty(p.MacAddress) ? "—" : p.MacAddress)</td>
                        <td><span class="badge badge-@p.Status">@p.Status</span></td>
                        <td class="remarks-cell">
                            @if (string.IsNullOrEmpty(p.Remarks))
                            {
                                <span class="remarks-none">—</span>
                            }
                            else
                            {
                                @p.Remarks
                            }
                        </td>
                        <td class="nowrap">
                            <div class="action-wrap">
                                <button class="btn-dots" onclick="toggleDropdown(this, event); event.stopPropagation();">                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
                                    </svg>
                                </button>
                                <div class="dropdown-menu">
                                    <button class="dropdown-item" onclick="openEditModal(this.closest('tr'))">                                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                        Edit
                                    </button>
                                    <button class="dropdown-item item-replace" onclick="openReplaceModal(this.closest('tr'))">                                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                                        Replace
                                    </button>
                                    <div class="dropdown-divider"></div>
                                    <button class="dropdown-item item-delete" onclick="confirmDelete(@p.Id, '@Html.Raw(p.Name.Replace("'","\'"))')">
                                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6m4-6v6"/></svg>
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-bar" id="paginationBar" style="display:none;">
        <span class="pagination-info" id="paginationInfo"></span>
        <div class="pagination-btns" id="paginationBtns"></div>
    </div>
</div>

@* ════════════════════════════════════════════════════════════
   ADD MODAL
   ════════════════════════════════════════════════════════════ *@
<div class="modal-overlay" id="addModal">
    <div class="modal">
        <div class="modal-header">
            <h3>Add New Printer</h3>
            <button class="modal-close" onclick="closeModal('addModal')">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form method="post" action="@Url.Action("Add")">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16" height="16"><rect x="2" y="3" width="20" height="14" rx="2"/></svg>                    Printer Information
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Printer Name <span class="required">*</span></label>
                        <input type="text" name="Name" placeholder="e.g. Printer Lab 101" required>
                    </div>
                    <div class="form-group">
                        <label>Vendor</label>
                        <input type="text" name="Vendor" placeholder="e.g. HP, Canon">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Model</label>
                        <input type="text" name="Model" placeholder="e.g. LaserJet Pro M404n">
                    </div>
                    <div class="form-group">
                        <label>Serial Number</label>
                        <input type="text" name="Serial" placeholder="Serial / asset tag">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Building</label>
                        <input type="text" name="Building" placeholder="e.g. Main Building">
                    </div>
                    <div class="form-group">
                        <label>Department</label>
                        <input type="text" name="Department" placeholder="e.g. IT Department">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>IP Address</label>
                        <input type="text" name="IpAddress" placeholder="192.168.1.x">
                    </div>
                    <div class="form-group">
                        <label>MAC Address</label>
                        <input type="text" name="MacAddress" placeholder="00:1A:2B:3C:4D:5E">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Status</label>
                        <select name="Status" id="addStatusSelect" onchange="toggleAddConditional(this.value)">
                            <option value="Active">Active</option>
                            <option value="Pullout">Pullout</option>
                            <option value="Replaced">Replaced</option>
                        </select>
                    </div>
                </div>
                <div id="addPulloutGroup" class="conditional-group hidden">
                    <div class="form-group">
                        <label>Pullout Date</label>
                        <input type="datetime-local" name="PulloutDate">
                    </div>
                </div>
                <div id="addReplacedGroup" class="conditional-group hidden">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Replaced Date</label>
                            <input type="datetime-local" name="ReplacedDate">
                        </div>
                        <div class="form-group">
                            <label>Replaced Location</label>
                            <input type="text" name="ReplacedLocation">
                        </div>
                    </div>
                </div>
                <div class="form-group">
