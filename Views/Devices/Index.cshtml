    const csv = 'device_name,borrower_name,department,date_borrowed,expected_return\r\nDell Laptop,John Smith,Engineering,2025-06-01,2025-06-30\r\nHP Monitor,Maria Santos,Accounting,2025-06-05,\r\n';
