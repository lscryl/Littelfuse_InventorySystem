                <div style="background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:.7rem;color:#555;line-height:1.9;">
                    <strong style="color:#333;">Required:</strong> device_name, borrower_name<br>
                    <strong style="color:#333;">Optional:</strong> department, date_borrowed, expected_return
                </div>
                <div style="margin-bottom:14px;">
                    <button type="button" onclick="downloadLoanTemplate()" style="display:inline-flex;align-items:center;gap:6px;font-size:.72rem;color:#25671E;padding:7px 14px;border:1.5px solid #c8e6c0;border-radius:8px;background:#f4fbf2;cursor:pointer;font-family:inherit;font-weight:600;">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download CSV Template
                    </button>
                </div>
                <label style="display:block;font-size:.7rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;">Select CSV File</label>
                <input type="file" id="importLoanFileInput" accept=".csv,text/csv" style="width:100%;padding:10px;border:1.5px solid #dde2ef;border-radius:8px;font-size:.78rem;font-family:inherit;background:#fff;cursor:pointer;">
                <p id="importLoanFileError" style="color:#c81e1e;font-size:.72rem;margin-top:6px;display:none;"></p>
            </div>
            <div id="importLoanStep2" style="display:none;">
                <div id="importLoanSummaryBar" style="display:flex;gap:10px;margin-bottom:14px;"></div>
                <div style="overflow-x:auto;max-height:300px;overflow-y:auto;border:1.5px solid #eef0f6;border-radius:10px;">
                    <table style="width:100%;border-collapse:collapse;min-width:400px;">
                        <thead><tr id="importLoanHead" style="position:sticky;top:0;background:#fff;z-index:1;"></tr></thead>
                        <tbody id="importLoanBody2"></tbody>
                    </table>
                </div>
                <p style="font-size:.68rem;color:#aaa;margin-top:8px;">Rows missing device_name or borrower_name will be skipped. Device must already exist in inventory.</p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" onclick="closeModal('importLoansModal')">Cancel</button>
            <button type="button" id="importLoanPreviewBtn" class="btn-submit" onclick="previewLoanImport()" style="display:none;">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15" height="15"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Preview
            </button>
            <form asp-action="ImportLoans" asp-controller="Devices" method="post" id="importLoanSubmitForm" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rows_json" id="importLoanRowsJson">
                <button type="submit" id="importLoanSubmitBtn" class="btn-submit">Import</button>
            </form>
        </div>
    </div>
</div>

@* ══ DETAIL DRAWER ══ *@
<div id="detailDrawerOverlay" onclick="closeDetailDrawer()"></div>
