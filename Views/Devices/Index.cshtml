@* ============================================================
   File: Views/Devices/Index.cshtml
   Purpose: Loaner Laptop page — Inventory + Borrowed tabs.
            Converted from devices.php.
   ============================================================ *@

@model ITInventorySystem.Models.DevicesViewModel

@{
    ViewData["Title"] = "Loaner Laptops";
}

<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Main ── */
    .main { flex: 1; padding: 24px 44px; overflow: hidden; display: flex; flex-direction: column; min-height: 0; height: 100vh; }

    /* ── Page header ── */
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-shrink: 0; border-bottom: 2px solid #e4e7f0; padding-bottom: 0; }
    .page-header h2 { font-size: 1.65rem; font-weight: 700; color: #111; padding-bottom: 12px; }

    /* ── Main Tabs ── */
    .tabs-bar { display: flex; align-items: center; }
    .tab-btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; color: #888; background: none; border: none; border-bottom: 2.5px solid transparent; margin-bottom: -2px; cursor: pointer; text-decoration: none; white-space: nowrap; transition: color .18s, border-color .18s; }
    .tab-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
    .tab-btn:hover { color: #25671E; }
    .tab-btn.active { color: #25671E; border-bottom-color: #25671E; }
    .tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 18px; padding: 0 6px; border-radius: 9px; font-size: .62rem; font-weight: 700; background: #eef0f6; color: #777; }
    .tab-btn.active .tab-count { background: #d6edcf; color: #1d5618; }

    /* ── Tab panels ── */
    .tab-panel { display: none; flex: 1; flex-direction: column; min-height: 0; overflow: hidden; }
    .tab-panel.active { display: flex; }

    /* ── Toolbar ── */
    .toolbar { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; flex-shrink: 0; }
    .search-wrap { flex: 1; position: relative; }
    .search-wrap svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #999; pointer-events: none; }
    .search-wrap input { width: 100%; padding: 11px 14px 11px 42px; border: 1.5px solid #dde2ef; border-radius: 10px; font-size: .75rem; background: #fff; color: #222; outline: none; transition: border-color .18s; font-family: 'Segoe UI', Arial, sans-serif; }
    .search-wrap input:focus { border-color: #25671E; }
    .btn-new { display: inline-flex; align-items: center; gap: 7px; background: #25671E; color: #fff; border: none; padding: 11px 22px; border-radius: 10px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; white-space: nowrap; transition: background .18s; }
    .btn-new:hover { background: #48A111; }
    .btn-outline { display: inline-flex; align-items: center; gap: 7px; background: #fff; color: #444; border: 1.5px solid #dde2ef; padding: 11px 18px; border-radius: 10px; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; white-space: nowrap; transition: background .18s, border-color .18s; }
    .btn-outline:hover { background: #f4f6fb; border-color: #c8cce0; }

    /* ── Table Card ── */
    .table-card { background: #fff; border-radius: 14px; box-shadow: 0 1px 6px rgba(0,0,0,.07); display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }
    .table-scroll { overflow: auto; flex: 1; }
    table { width: 100%; border-collapse: collapse; min-width: 700px; }
    thead th { text-align: left; padding: 14px 18px; font-size: .65rem; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1.5px solid #eef0f6; background: #fff; position: sticky; top: 0; z-index: 1; }
    tbody tr { border-bottom: 1px solid #f2f4fb; transition: background .14s; }
    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #f7f9ff; }
    td { padding: 14px 18px; font-size: .75rem; vertical-align: middle; }
    .clickable-row { cursor: pointer; }
    .device-name { font-weight: 600; color: #111; }
    .device-model { color: #333; }
    .empty-row td { text-align: center; color: #aaa; padding: 40px; font-size: .8rem; }

    /* Badges */
    .badge { display: inline-block; padding: 4px 13px; border-radius: 20px; font-size: .6rem; font-weight: 600; letter-spacing: .02em; }
    .badge-available { background: #e3fbec; color: #0e9a4a; }
    .badge-borrowed  { background: #e8f0fe; color: #1a56db; }
    .badge-overdue   { background: #fff3e0; color: #e65100; }
    .text-overdue    { color: #e65100; font-weight: 700; }

    /* ── 3-dot dropdown ── */
    .action-wrap { position: relative; display: inline-block; }
    .btn-dots { background: none; border: none; cursor: pointer; padding: 6px 8px; border-radius: 6px; color: #666; display: inline-flex; align-items: center; justify-content: center; transition: background .15s; }
    .btn-dots:hover { background: #eef0fb; color: #333; }
    .btn-dots svg { width: 18px; height: 18px; }
    .dropdown-menu { display: none; position: fixed; background: #fff; border: 1.5px solid #eef0f6; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.12); min-width: 165px; z-index: 200; overflow: hidden; animation: fadeIn .15s ease; }
    .dropdown-menu.open { display: block; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    .dropdown-item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: .65rem; font-weight: 500; color: #333; cursor: pointer; border: none; background: none; width: 100%; text-align: left; transition: background .13s; font-family: 'Segoe UI', Arial, sans-serif; }
    .dropdown-item:hover { background: #f4f6fb; }
    .dropdown-item svg { width: 15px; height: 15px; flex-shrink: 0; color: #666; }
    .dropdown-item.item-borrow { color: #1a56db; } .dropdown-item.item-borrow svg { color: #1a56db; }
    .dropdown-item.item-edit   { color: #25671E; } .dropdown-item.item-edit svg   { color: #25671E; }
    .dropdown-item.item-delete { color: #c81e1e; } .dropdown-item.item-delete svg { color: #c81e1e; }
    .dropdown-divider { height: 1px; background: #eef0f6; margin: 4px 0; }

    /* ── Overdue filter tabs ── */
    .loan-filter-tabs { display: flex; gap: 6px; }
    .filter-tab { padding: 8px 16px; border-radius: 8px; border: 1.5px solid #dde2ef; background: #fff; font-size: .72rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; color: #666; cursor: pointer; transition: all .15s; }
    .filter-tab.active { background: #25671E; color: #fff; border-color: #25671E; }
    .filter-tab.overdue-highlight { border-color: #f5c2c2; color: #c81e1e; }
    .filter-tab.overdue-highlight.active { background: #c81e1e; color: #fff; border-color: #c81e1e; }

    /* ── Pagination ── */
    .pagination-bar { display: none; align-items: center; justify-content: space-between; padding: 12px 18px; border-top: 1px solid #eef0f6; flex-shrink: 0; }
    .pagination-info { font-size: .72rem; color: #888; }
    .pagination-btns { display: flex; gap: 4px; }
    .page-btn { min-width: 32px; height: 32px; padding: 0 8px; border-radius: 7px; border: 1.5px solid #dde2ef; background: #fff; color: #555; font-size: .72rem; font-weight: 600; cursor: pointer; transition: background .15s; display: inline-flex; align-items: center; justify-content: center; }
    .page-btn:hover:not(:disabled) { background: #f4f6fb; }
    .page-btn.active { background: #25671E; color: #fff; border-color: #25671E; }
    .page-btn:disabled { opacity: .4; cursor: default; }
    .page-btn svg { width: 14px; height: 14px; }

    /* ── Modal ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 300; align-items: center; justify-content: center; }
    .modal-overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 16px; width: 560px; max-width: 96vw; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,.18); animation: slideUp .22s ease; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .modal-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 24px 32px 16px; border-bottom: 1.5px solid #eef0f6; }
    .modal-header h3 { font-size: 1rem; font-weight: 700; color: #111; }
    .modal-header-sub { font-size: .72rem; color: #888; margin-top: 3px; }
    .modal-close { background: none; border: none; cursor: pointer; color: #aaa; padding: 4px; border-radius: 6px; transition: color .15s; display: flex; }
    .modal-close:hover { color: #333; }
    .modal-close svg { width: 20px; height: 20px; }
    .modal-body { padding: 24px 32px 8px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: .7rem; font-weight: 600; color: #555; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .form-group input, .form-group select { width: 100%; padding: 10px 14px; border: 1.5px solid #dde2ef; border-radius: 8px; font-size: .78rem; font-family: 'Segoe UI', Arial, sans-serif; color: #222; background: #fafbff; outline: none; transition: border-color .18s; }
    .form-group input:focus, .form-group select:focus { border-color: #25671E; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .required { color: #c81e1e; margin-left: 2px; }
    .modal-footer { padding: 18px 32px 26px; display: flex; justify-content: flex-end; gap: 10px; }
    .btn-cancel { padding: 10px 22px; border-radius: 8px; border: 1.5px solid #dde2ef; background: #fff; color: #555; font-size: .75rem; font-weight: 600; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .15s; }
    .btn-cancel:hover { background: #f4f6fb; }
    .btn-submit { padding: 10px 26px; border-radius: 8px; border: none; background: #25671E; color: #fff; font-size: .75rem; font-weight: 700; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .18s; }
    .btn-submit:hover { background: #48A111; }

    /* ── Confirm modal ── */
    .confirm-modal { background: #fff; border-radius: 14px; width: 360px; max-width: 96vw; padding: 28px; box-shadow: 0 16px 48px rgba(0,0,0,.16); animation: slideUp .2s ease; text-align: center; }
    .confirm-modal .del-icon { width: 52px; height: 52px; border-radius: 50%; background: #fde8e8; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
    .confirm-modal .del-icon svg { width: 26px; height: 26px; color: #c81e1e; }
    .confirm-modal h3 { font-size: 1rem; font-weight: 700; color: #111; margin-bottom: 8px; }
    .confirm-modal p { font-size: .75rem; color: #666; margin-bottom: 22px; }
    .confirm-modal-btns { display: flex; justify-content: center; gap: 10px; }
    .btn-danger { padding: 10px 22px; border-radius: 8px; border: none; background: #c81e1e; color: #fff; font-size: .75rem; font-weight: 700; font-family: 'Segoe UI', Arial, sans-serif; cursor: pointer; transition: background .18s; }
    .btn-danger:hover { background: #a81818; }

    /* ── Detail Drawer ── */
    #detailDrawerOverlay { display: none; position: fixed; inset: 0; background: rgba(20,30,60,.35); z-index: 150; }
    #detailDrawer { position: fixed; top: 0; right: 0; height: 100vh; width: 420px; max-width: 96vw; background: #fff; box-shadow: -8px 0 40px rgba(0,0,0,.13); z-index: 151; display: flex; flex-direction: column; transform: translateX(100%); transition: transform .28s cubic-bezier(.4,0,.2,1); overflow: hidden; }
    .drawer-header { padding: 24px 28px 16px; border-bottom: 1.5px solid #eef0f6; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }
    .drawer-body { flex: 1; overflow-y: auto; padding: 22px 28px; }
    .drawer-section-label { font-size: .6rem; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: .07em; margin-bottom: 10px; }
    .drawer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
    .drawer-cell { background: #f8f9fe; border: 1.5px solid #eef0f6; border-radius: 10px; padding: 13px 15px; }
    .drawer-cell-label { font-size: .6rem; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
    .drawer-cell-value { font-size: .8rem; font-weight: 600; color: #222; }

    /* ── Import modal ── */
    .import-modal { width: 680px; max-width: 96vw; }

    /* ── Toast ── */
    .toast { position: fixed; bottom: 28px; right: 28px; display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 12px; background: #222; color: #fff; font-size: .78rem; font-weight: 600; box-shadow: 0 8px 24px rgba(0,0,0,.18); z-index: 9999; transform: translateY(80px); opacity: 0; transition: transform .3s ease, opacity .3s ease; min-width: 240px; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast svg { width: 18px; height: 18px; flex-shrink: 0; }
    .toast-success { background: #1c6b34; }
    .toast-error   { background: #c81e1e; }
</style>

<div class="main">

    @* ── PAGE HEADER + TABS ── *@
    <div class="page-header">
        <h2>🖳 Loaner Laptops</h2>
        <div class="tabs-bar">
            <a href="@Url.Action("Index","Devices", new { tab="inventory" })"
               class="tab-btn @(Model.ActiveTab=="inventory"?"active":"")">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
                </svg>
                Inventory <span class="tab-count">@Model.CountAvailable</span>
            </a>
            <a href="@Url.Action("Index","Devices", new { tab="borrowed" })"
               class="tab-btn @(Model.ActiveTab=="borrowed"?"active":"")">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M5 8h14M5 8a2 2 0 1 0 0-4h14a2 2 0 1 0 0 4M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/>
                </svg>
                Borrowed <span class="tab-count">@Model.CountBorrowed</span>
            </a>
        </div>
    </div>

    @* ── INVENTORY TAB PANEL ── *@
    <div class="tab-panel @(Model.ActiveTab=="inventory"?"active":"")" id="panel-inventory">
        <div class="toolbar">
            <div class="search-wrap">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="text" id="devSearchInput" placeholder="Search by device name, model or serial number..." onkeyup="renderTable()">
            </div>
            <button class="btn-outline" onclick="exportDevicesCSV()">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export CSV
            </button>
            <button class="btn-outline" onclick="openImportDevicesModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Import CSV
            </button>
            <button class="btn-new" onclick="openAddDeviceModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14"/></svg>
                Add Device
            </button>
        </div>

        <div class="table-card">
            <div class="table-scroll">
                <table id="devTable">
                    <thead>
                        <tr>
                            <th>Computer Name</th>
                            <th>Borrower</th>
                            <th>Department</th>
                            <th>Model</th>
                            <th>Serial Number</th>
                            <th>Loaner Created</th>
                            <th>Date to Return</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Devices.Any())
                        {
                            <tr class="empty-row"><td colspan="9">No devices found.</td></tr>
                        }
                        else
                        {
                            @foreach (var d in Model.Devices)
                            {
                                var rowId = $"dev-dd-{d.Id}";
                                var drawerData = System.Text.Json.JsonSerializer.Serialize(new {
                                    id             = d.Id,
                                    device_name    = d.DeviceName,
                                    department     = d.Department,
                                    model          = d.Model,
                                    serial_number  = d.SerialNumber,
                                    os_name        = d.OsName,
                                    release_id     = d.ReleaseId,
                                    pic            = d.Pic,
                                    created_at     = d.CreatedAt,
                                    exp_return     = d.ExpectedReturn ?? "",
                                    borrower_name  = d.BorrowerName ?? "",
                                    bu             = d.LoanDept ?? "",
                                    date_borrowed  = d.DateBorrowed ?? ""
                                });
                                <tr class="clickable-row" onclick="openDetailDrawer(@Html.Raw(drawerData))">
                                    <td><div class="device-name">@d.DeviceName</div></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.BorrowerName))
                                        {
                                            <span class="device-name" style="color:#1a56db;">@d.BorrowerName</span>
                                        }
                                        else
                                        {
                                            <span style="color:#ccc;">—</span>
                                        }
                                    </td>
                                    <td><span class="device-model">@(string.IsNullOrEmpty(d.LoanDept ?? d.Department) ? "—" : (d.LoanDept ?? d.Department))</span></td>
                                    <td><span class="device-model">@(string.IsNullOrEmpty(d.Model) ? "—" : d.Model)</span></td>
                                    <td><span class="device-model">@(string.IsNullOrEmpty(d.SerialNumber) ? "—" : d.SerialNumber)</span></td>
                                    <td><span class="device-model">@d.CreatedAt</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.ExpectedReturn))
                                        {
                                            <span class="device-model">@d.ExpectedReturn</span>
                                        }
                                        else
                                        {
                                            <span style="color:#ccc;">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(d.BorrowerName))
                                        {
                                            <span class="badge badge-borrowed">On Loan</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-available">Available</span>
                                        }
                                    </td>
                                    <td onclick="event.stopPropagation()">
                                        <div class="action-wrap">
                                            <button class="btn-dots" onclick="toggleDropdown('@rowId', event)" title="Actions">
                                                <svg fill="currentColor" viewBox="0 0 24 24">
                                                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu" id="@rowId">
                                                <button class="dropdown-item item-borrow"
                                                    onclick="closeAllDropdowns(); openBorrowModal(@d.Id, '@Html.Raw(d.DeviceName.Replace("'","\\\'"))', '@Html.Raw(d.Model.Replace("'","\\\'"))')">
                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 8h14M5 8a2 2 0 1 0 0-4h14a2 2 0 1 0 0 4M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><path d="M10 12h4M12 10v4"/></svg>
                                                    Borrow Device
                                                </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item item-edit"
                                                    onclick="closeAllDropdowns(); openEditDeviceModal(@d.Id, '@Html.Raw(d.DeviceName.Replace("'","\\\'"))', '@Html.Raw(d.SerialNumber.Replace("'","\\\'"))', '@Html.Raw(d.Model.Replace("'","\\\'"))', '@Html.Raw(d.Department.Replace("'","\\\'"))', '@Html.Raw(d.OsName.Replace("'","\\\'"))', '@Html.Raw(d.ReleaseId.Replace("'","\\\'"))', '@Html.Raw(d.Pic.Replace("'","\\\'"))')">
                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                    Edit Device
                                                </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item item-delete"
                                                    onclick="closeAllDropdowns(); openDeleteDeviceModal(@d.Id, '@Html.Raw(d.DeviceName.Replace("'","\\\'"))')">
                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar" id="paginationBar">
                <span class="pagination-info" id="paginationInfo"></span>
                <div class="pagination-btns" id="paginationBtns"></div>
            </div>
        </div>
    </div>@* /panel-inventory *@

    @* ── BORROWED TAB PANEL ── *@
    <div class="tab-panel @(Model.ActiveTab=="borrowed"?"active":"")" id="panel-borrowed">
        <div class="toolbar">
            <div class="search-wrap">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input type="text" id="loanSearchInput" placeholder="Search by device, model, serial, borrower..." onkeyup="liveSearch(this.value)">
            </div>
            <button class="btn-outline" onclick="exportLoansCSV()">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export CSV
            </button>
            <button class="btn-outline" onclick="openImportLoansModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Import CSV
            </button>
            <button class="btn-new" onclick="openAddBorrowModal()">
                <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M5 12h14"/></svg>
                Borrow
            </button>
            @if (Model.CountOverdue > 0)
            {
                <div class="loan-filter-tabs">
                    <button class="filter-tab active" id="loanFilterAll" onclick="setLoanFilter('all')">All (@Model.CountBorrowed)</button>
                    <button class="filter-tab overdue-highlight" id="loanFilterOverdue" onclick="setLoanFilter('overdue')">Overdue (@Model.CountOverdue)</button>
                </div>
            }
        </div>

        <div class="table-card">
            <div class="table-scroll">
                <table id="loanTable">
                    <thead>
                        <tr>
                            <th>Device Name</th>
                            <th>Model</th>
                            <th>Serial Number</th>
                            <th>Borrower</th>
                            <th>Department</th>
                            <th>Date Borrowed</th>
                            <th>Expected Return</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Loans.Any())
                        {
                            <tr class="empty-row"><td colspan="9">No borrowed devices found.</td></tr>
                        }
                        else
                        {
@foreach (var l in Model.Loans)
{
    var searchVal = $"{l.DeviceName} {l.Model} {l.SerialNumber} {l.BorrowerName} {l.Department} {(l.IsOverdue ? "overdue" : "borrowed")}".ToLower();

    var loanDetail = System.Text.Json.JsonSerializer.Serialize(new
    {
        device_name     = l.DeviceName ?? "",
        model           = l.Model ?? "",
        serial_number   = l.SerialNumber ?? "",
        borrower_name   = l.BorrowerName ?? "",
        department      = l.Department ?? "",
        date_borrowed   = l.DateBorrowed ?? "",
        expected_return = l.ExpectedReturn ?? "",
        status          = l.IsOverdue ? "Overdue" : "Borrowed"
    });

    <tr class="clickable-row"
        data-search="@searchVal"
        data-detail="@Html.Encode(loanDetail)"
        onclick="openRowDetailModal(this)">

        <td>@l.DeviceName</td>
    <td>@l.Model</td>
    <td>@l.SerialNumber</td>
    <td>@l.BorrowerName</td>
    <td>@l.Department</td>
    <td>@l.DateBorrowed</td>

                                    <td>
    @if (!string.IsNullOrEmpty(l.ExpectedReturn))
    {
        <span class="@(l.IsOverdue ? "text-overdue" : "")">
            @l.ExpectedReturn
        </span>
    }
    else
    {
        <span style="color:#ccc;">—</span>
    }
</td>
                                    <td>
                                        @if (l.IsOverdue)
                                        {
                                            <span class="badge badge-overdue">Overdue</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-borrowed">Borrowed</span>
                                        }
                                    </td>
                                    <td onclick="event.stopPropagation()">
                                            <div class="action-wrap">
                                                <button class="btn-dots" onclick="toggleDropdown('loan-dd-@l.Id', event)" title="Actions">
    <svg fill="currentColor" viewBox="0 0 24 24">
                                                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu" id="loan-dd-@l.Id">
                                                <button class="dropdown-item item-edit"
                                                    onclick="closeAllDropdowns(); openEditLoanModal(@l.Id, 
                                                    '@Html.Raw((l.BorrowerName ?? "").Replace("'","\\\'"))','@Html.Raw((l.Department ?? "").Replace("'","\\\'"))', '@l.DateBorrowed', '@(l.ExpectedReturn??"")', '@l.Status', '@(l.DateReturned??"")')">
                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                    Edit
                                                </button>
                                                <div class="dropdown-divider"></div>
                                                <button class="dropdown-item item-delete"
onclick="closeAllDropdowns(); openDeleteLoanModal(@l.Id, '@Html.Raw((l.DeviceName ?? "").Replace("'","\\\'"))')">                                                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                                    Delete
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar" id="loanPaginationBar">
                <span class="pagination-info" id="loanPaginationInfo"></span>
                <div class="pagination-btns" id="loanPaginationBtns"></div>
            </div>
        </div>
    </div>@* /panel-borrowed *@

</div>@* /main *@

