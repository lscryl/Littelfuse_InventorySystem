/* ── Import Loans ── */
let importLoanRows = [];

function openImportLoansModal() {
    importLoanRows = [];
    document.getElementById('importLoanStep1').style.display = '';
    document.getElementById('importLoanStep2').style.display = 'none';
    document.getElementById('importLoanPreviewBtn').style.display = 'none';
    document.getElementById('importLoanSubmitForm').style.display = 'none';
    document.getElementById('importLoanFileInput').value = '';
    document.getElementById('importLoanFileError').style.display = 'none';
    openModal('importLoansModal');
}

document.addEventListener('DOMContentLoaded', () => {
    const lfi = document.getElementById('importLoanFileInput');
    if (lfi) lfi.addEventListener('change', function () {
        const errEl   = document.getElementById('importLoanFileError');
        const prevBtn = document.getElementById('importLoanPreviewBtn');
        errEl.style.display = 'none'; prevBtn.style.display = 'none';
        if (!this.files?.[0]) return;
        if (!this.files[0].name.toLowerCase().endsWith('.csv')) {
            errEl.textContent = 'Please select a .csv file.';
            errEl.style.display = 'block'; return;
        }
        prevBtn.style.display = '';
    });
});

function previewLoanImport() {
    const file = document.getElementById('importLoanFileInput').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function (e) {
        const parsed = parseCSV(e.target.result);
        if (parsed.length < 2) {
            document.getElementById('importLoanFileError').textContent = 'CSV appears empty or has no data rows.';
            document.getElementById('importLoanFileError').style.display = 'block'; return;
        }
        const headers  = parsed[0].map(h => h.trim().toLowerCase().replace(/\s+/g, '_'));
        const dataRows = parsed.slice(1);
        importLoanRows = []; let skipped = 0;
        dataRows.forEach(row => {
            const obj = {}; headers.forEach((h, i) => { obj[h] = (row[i] || '').trim(); });
            if (!obj.device_name || !obj.borrower_name) { skipped++; return; }
            importLoanRows.push(obj);
        });
        const ready = importLoanRows.length, total = dataRows.length;
        document.getElementById('importLoanStep1').style.display = 'none';
        document.getElementById('importLoanStep2').style.display = '';
        document.getElementById('importLoanPreviewBtn').style.display = 'none';
        document.getElementById('importLoanSubmitForm').style.display = '';
        document.getElementById('importLoanRowsJson').value = JSON.stringify(importLoanRows);
        document.getElementById('importLoanSubmitBtn').textContent = `Import ${ready} Loan${ready !== 1 ? 's' : ''}`;

        document.getElementById('importLoanSummaryBar').innerHTML =
            `<div style="flex:1;background:#f4fbf2;border:1.5px solid #c8e6c0;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#0e9a4a;">${ready}</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Ready to import</div></div>` +
            (skipped ? `<div style="flex:1;background:#fde8e8;border:1.5px solid #f5c2c2;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#c81e1e;">${skipped}</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Skipped</div></div>` : '') +
            `<div style="flex:1;background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:10px;text-align:center;"><div style="font-size:1.1rem;font-weight:600;color:#333;">${total}</div><div style="font-size:.65rem;color:#555;margin-top:2px;">Total rows</div></div>`;

        const cols    = ['device_name', 'borrower_name', 'department', 'date_borrowed', 'expected_return'];
        const clabels = ['Device Name', 'Borrower', 'Department', 'Date Borrowed', 'Expected Return'];
        document.getElementById('importLoanHead').innerHTML =
            clabels.map(l => `<th style="text-align:left;padding:10px 14px;font-size:.63rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:.04em;border-bottom:1.5px solid #eef0f6;white-space:nowrap;">${l}</th>`).join('') +
            `<th style="border-bottom:1.5px solid #eef0f6;"></th>`;
        document.getElementById('importLoanBody2').innerHTML =
            importLoanRows.slice(0, 50).map(r =>
                `<tr style="border-bottom:1px solid #f2f4fb;">` +
                cols.map(c => `<td style="padding:10px 14px;font-size:.73rem;color:#333;white-space:nowrap;">${r[c] || '<span style="color:#ccc;">—</span>'}</td>`).join('') +
                `<td style="padding:10px 14px;"><span style="background:#e3fbec;color:#0e9a4a;padding:3px 10px;border-radius:20px;font-size:.6rem;font-weight:700;">OK</span></td></tr>`
            ).join('') +
            (importLoanRows.length > 50 ? `<tr><td colspan="6" style="text-align:center;padding:10px;font-size:.7rem;color:#aaa;">… and ${importLoanRows.length - 50} more rows</td></tr>` : '');
    };
    reader.readAsText(file);
}

