@section Scripts {
<script>

/* ── Row detail modal (borrowed tab) ── */
function openRowDetailModal(row) {
    if (event.target.closest('.action-wrap')) return;

    const rawJson = row.dataset.detail
        .replace(/&amp;/g,  '&')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g,  "'")
        .replace(/&lt;/g,   '<')
        .replace(/&gt;/g,   '>');

    const d = JSON.parse(rawJson);

    document.getElementById('rdmTitle').textContent = d.device_name || 'Details';
    document.getElementById('rdmSub').textContent   = [d.model, d.serial_number].filter(Boolean).join(' · ');

    const fields = [
        ['Device',           d.device_name],
        ['Model',            d.model],
        ['Serial Number',    d.serial_number],
        ['Borrower',         d.borrower_name],
        ['Department',       d.department],
        ['Date Borrowed',    d.date_borrowed],
        ['Expected Return',  d.expected_return],
        ['Status',           d.status],
    ];

    document.getElementById('rdmGrid').innerHTML = fields.map(([label, val]) => `
        <div style="background:#f8f9fe;border:1.5px solid #eef0f6;border-radius:10px;padding:13px 16px;">
            <div style="font-size:.6rem;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">${label}</div>
            <div style="font-size:.8rem;font-weight:600;color:${label==='Status'&&d.status==='Overdue'?'#e65100':label==='Borrower'?'#1a56db':'#222'};">${val || '—'}</div>
        </div>`
    ).join('');

    openModal('rowDetailModal');
}

/* ── Dropdown ── */
function toggleDropdown(id, e) {
    e.stopPropagation();
    const menu = document.getElementById(id);
    const isOpen = menu.classList.contains('open');
    closeAllDropdowns();
    if (!isOpen) {
        const rect = e.currentTarget.getBoundingClientRect();
        menu.style.right  = (window.innerWidth - rect.right) + 'px';
        const spaceB = window.innerHeight - rect.bottom;
        if (spaceB < 160) { menu.style.bottom = (window.innerHeight - rect.top + 4) + 'px'; menu.style.top = 'auto'; }
        else              { menu.style.top    = (rect.bottom + 4) + 'px'; menu.style.bottom = 'auto'; }
        menu.classList.add('open');
    }
}
function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu.open').forEach(m => m.classList.remove('open'));
}
document.addEventListener('click', closeAllDropdowns);

/* ── Modal helpers ── */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(el => {
    el.addEventListener('click', function(e) { if (e.target === this) closeModal(this.id); });
});

/* ── Borrow modal ── */
function openBorrowModal(deviceId, deviceName, model) {
    document.getElementById('borrowDeviceId').value    = deviceId;
    document.getElementById('borrowModalSub').textContent = deviceName + (model ? ' · ' + model : '');
    document.getElementById('borrowDateInput').value   = new Date().toISOString().split('T')[0];
    document.getElementById('borrowerNameInput').value = '';
    openModal('borrowModal');
    setTimeout(() => document.getElementById('borrowerNameInput').focus(), 200);
}

/* ── Add device modal ── */
function openAddDeviceModal() { openModal('addDeviceModal'); }

/* ── Edit device modal ── */
function openEditDeviceModal(id, name, serial, model, dept, osName, releaseId, pic) {
    document.getElementById('editDeviceId').value     = id;
    document.getElementById('editDeviceName').value   = name;
    document.getElementById('editSerialNumber').value = serial;
    document.getElementById('editModel').value        = model;
    document.getElementById('editDeviceDept').value   = dept || '';
    document.getElementById('editOsName').value       = osName || '';
    document.getElementById('editReleaseId').value    = releaseId || '';
    document.getElementById('editPic').value          = pic || '';
    openModal('editDeviceModal');
}

/* ── Delete device modal ── */
function openDeleteDeviceModal(id, name) {
    document.getElementById('deleteDeviceId').value = id;
    document.getElementById('deleteDeviceMsg').textContent = 'You are about to delete "' + name + '". This cannot be undone.';
    openModal('deleteDeviceModal');
}

/* ── Edit loan modal ── */
function openEditLoanModal(id, borrower, dept, dateBorrowed, expectedReturn, status, dateReturned) {
    document.getElementById('editLoanId').value           = id;
    document.getElementById('editLoanBorrower').value     = borrower;
    document.getElementById('editLoanDept').value         = dept;
    document.getElementById('editLoanDateBorrowed').value = dateBorrowed;
    document.getElementById('editLoanExpected').value     = expectedReturn;
    document.getElementById('editLoanStatus').value       = status;
    document.getElementById('editLoanDateReturned').value = dateReturned || '';
    openModal('editLoanModal');
}

/* ── Add & Borrow modal ── */
function openAddBorrowModal() {
    document.getElementById('addBorrowDateInput').value = new Date().toISOString().split('T')[0];
    openModal('addBorrowModal');
}
/* ── Delete loan modal ── */
function openDeleteLoanModal(id, deviceName) {
    document.getElementById('deleteLoanId').value = id;
    document.getElementById('deleteLoanMsg').textContent = 'You are about to delete the loan record for "' + deviceName + '". This cannot be undone.';
    openModal('deleteLoanModal');
}

/* ── Detail drawer ── */
function openDetailDrawer(data) {
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || '—'; };
    set('drComputerName', data.device_name);
    set('drDept',         data.department);
    set('drModel',        data.model);
    set('drSerial',       data.serial_number);
    set('drOs',           data.os_name);
    set('drRelease',      data.release_id);
    set('drPic',          data.pic);
    set('drCreated',      data.created_at ? data.created_at.substring(0, 10) : '');
    set('drBorrower',     data.borrower_name);
    set('drBu',           data.bu);
    set('drDeployDate',   data.date_borrowed);
    set('drReturnDate',   data.exp_return);
    const isLoaned = !!data.borrower_name;
    const statusEl = document.getElementById('drStatus');
    const stateEl  = document.getElementById('drCurrentState');
    if (statusEl) { statusEl.textContent = isLoaned ? 'On Loan' : 'Available'; statusEl.style.color = isLoaned ? '#e65100' : '#0e9a4a'; }
    if (stateEl)  { stateEl.textContent  = isLoaned ? 'In Use' : 'In Stock'; }
    document.getElementById('drawerTitle').textContent = data.device_name || 'Device Details';
    document.getElementById('drawerSub').textContent   = [data.model, data.serial_number].filter(Boolean).join(' · ');
    document.getElementById('detailDrawerOverlay').style.display = 'block';
    document.getElementById('detailDrawer').style.transform = 'translateX(0)';
}
function closeDetailDrawer() {
    document.getElementById('detailDrawer').style.transform = 'translateX(100%)';
    document.getElementById('detailDrawerOverlay').style.display = 'none';
}

/* ── Inventory pagination + search ── */
let currentPage = 1;
const PAGE_SIZE = 50;

function renderTable() {
    const query   = document.getElementById('devSearchInput').value.toLowerCase();
    const allRows = Array.from(document.querySelectorAll('#devTable tbody tr:not(.empty-row)'));
    const filtered = allRows.filter(row => { const m = row.textContent.toLowerCase().includes(query); row.style.display = 'none'; return m; });
    document.querySelectorAll('#devTable tbody tr.empty-row').forEach(r => r.remove());
    if (filtered.length === 0) {
        const tr = document.createElement('tr'); tr.className = 'empty-row';
        tr.innerHTML = '<td colspan="9">No devices match your search.</td>';
        document.querySelector('#devTable tbody').appendChild(tr);
        document.getElementById('paginationBar').style.display = 'none'; return;
    }
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentPage > totalPages) currentPage = totalPages;
    const start = (currentPage - 1) * PAGE_SIZE, end = Math.min(start + PAGE_SIZE, filtered.length);
    filtered.forEach((row, i) => { row.style.display = (i >= start && i < end) ? '' : 'none'; });
    document.getElementById('paginationInfo').textContent = `Showing ${start+1}–${end} of ${filtered.length} device${filtered.length!==1?'s':''}`;
    document.getElementById('paginationBar').style.display = 'flex';
    buildPagination('paginationBtns', currentPage, totalPages, p => { currentPage = p; renderTable(); });
}

/* ── Loan table search + filter + pagination ── */
let currentLoanFilter = 'all', currentLoanPage = 1;

function setLoanFilter(filter) {
    currentLoanFilter = filter;
    ['all','overdue'].forEach(f => document.getElementById('loanFilter' + f.charAt(0).toUpperCase() + f.slice(1))?.classList.toggle('active', f === filter));
    currentLoanPage = 1; renderLoanTable();
}
function liveSearch() { currentLoanPage = 1; renderLoanTable(); }
function renderLoanTable() {
    const query   = document.getElementById('loanSearchInput').value.toLowerCase();
    const allRows = Array.from(document.querySelectorAll('#loanTable tbody tr:not(.empty-row)'));
    const filtered = allRows.filter(row => {
        const sd = row.dataset.search || '';
        const ok = (!query || sd.includes(query)) && (currentLoanFilter === 'all' || sd.includes(currentLoanFilter));
        row.style.display = 'none'; return ok;
    });
    document.querySelectorAll('#loanTable tbody tr.empty-row').forEach(r => r.remove());
    if (filtered.length === 0) {
        const tr = document.createElement('tr'); tr.className = 'empty-row';
        tr.innerHTML = '<td colspan="9">No borrowed devices match your search.</td>';
        document.querySelector('#loanTable tbody').appendChild(tr);
        document.getElementById('loanPaginationBar').style.display = 'none'; return;
    }
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    if (currentLoanPage > totalPages) currentLoanPage = totalPages;
    const start = (currentLoanPage - 1) * PAGE_SIZE, end = Math.min(start + PAGE_SIZE, filtered.length);
    filtered.forEach((row, i) => { row.style.display = (i >= start && i < end) ? '' : 'none'; });
    document.getElementById('loanPaginationInfo').textContent = `Showing ${start+1}–${end} of ${filtered.length} record${filtered.length!==1?'s':''}`;
    document.getElementById('loanPaginationBar').style.display = 'flex';
    buildPagination('loanPaginationBtns', currentLoanPage, totalPages, p => { currentLoanPage = p; renderLoanTable(); });
}

function buildPagination(containerId, current, total, onPage) {
    const btns = document.getElementById(containerId); btns.innerHTML = '';
    const prev = document.createElement('button'); prev.className = 'page-btn'; prev.disabled = current === 1;
    prev.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>`;
    prev.onclick = () => onPage(current - 1); btns.appendChild(prev);
    getPageRange(current, total).forEach(p => {
        const btn = document.createElement('button'); btn.className = 'page-btn' + (p === current ? ' active' : '');
        if (p === '...') { btn.disabled = true; btn.textContent = '…'; }
        else { btn.textContent = p; btn.onclick = () => onPage(p); }
        btns.appendChild(btn);
    });
    const next = document.createElement('button'); next.className = 'page-btn'; next.disabled = current === total;
    next.innerHTML = `<svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>`;
    next.onclick = () => onPage(current + 1); btns.appendChild(next);
}
function getPageRange(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
    const pages = [1];
    if (current > 3) pages.push('...');
    for (let p = Math.max(2, current-1); p <= Math.min(total-1, current+1); p++) pages.push(p);
    if (current < total - 2) pages.push('...');
    pages.push(total); return pages;
}

/* ── Export ── */
function exportDevicesCSV() {
    const rows = [['Computer Name','Borrower','Department','Model','Serial Number','Loaner Created','Date to Return','Status']];
    document.querySelectorAll('#devTable tbody tr:not(.empty-row)').forEach(tr => {
        if (tr.style.display === 'none') return;
        const c = tr.querySelectorAll('td');
        if (c.length < 8) return;
        rows.push([
            csvCell(c[0].textContent.trim()),
            csvCell(c[1].textContent.trim()),
            csvCell(c[2].textContent.trim()),
            csvCell(c[3].textContent.trim()),
            csvCell(c[4].textContent.trim()),
            csvCell(c[5].textContent.trim()),
            csvCell(c[6].textContent.trim()),
            csvCell(c[7].textContent.trim()),
        ]);
    });
    triggerCSVDownload(rows, 'devices_export.csv');
}

function exportLoansCSV() {
    const rows = [['Device Name','Model','Serial Number','Borrower','Department','Date Borrowed','Expected Return','Status']];
    document.querySelectorAll('#loanTable tbody tr:not(.empty-row)').forEach(tr => {
        if (tr.style.display === 'none') return;
        const c = tr.querySelectorAll('td');
        if (c.length < 8) return;
        rows.push([0,1,2,3,4,5,6,7].map(i => csvCell(c[i].textContent.trim())));
    });
    triggerCSVDownload(rows, 'loans_export.csv');
}
function csvCell(v) {
    const s = String(v || '');
    return (s.includes(',') || s.includes('"') || s.includes('\n')) ? '"' + s.replace(/"/g,'""') + '"' : s;
}
function triggerCSVDownload(rows, filename) {
    const csv  = rows.map(r => r.join(',')).join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href = url; a.download = filename; a.click();
    URL.revokeObjectURL(url);
}

/* ── Import ── */
let importDevRows = [];
function openImportDevicesModal() {
    importDevRows = [];
    document.getElementById('importDevStep1').style.display = '';
    document.getElementById('importDevStep2').style.display = 'none';
    document.getElementById('importDevPreviewBtn').style.display = 'none';
    document.getElementById('importDevSubmitForm').style.display = 'none';
    document.getElementById('importDevFileInput').value = '';
    document.getElementById('importDevFileError').style.display = 'none';
    openModal('importDevicesModal');
}
document.addEventListener('DOMContentLoaded', () => {
    const fi = document.getElementById('importDevFileInput');
    if (fi) fi.addEventListener('change', function() {
        const errEl = document.getElementById('importDevFileError');
        const prevBtn = document.getElementById('importDevPreviewBtn');
        errEl.style.display = 'none'; prevBtn.style.display = 'none';
        if (!this.files?.[0]) return;
        if (!this.files[0].name.toLowerCase().endsWith('.csv')) {
            errEl.textContent = 'Please select a .csv file.'; errEl.style.display = 'block'; return;
        }
        prevBtn.style.display = '';
    });
    renderTable();
    renderLoanTable();
    @if (Model.QrBorrowDevice != null)
    {
        <text>
        openBorrowModal(@Model.QrBorrowDevice.Id,
            '@Html.Raw(Model.QrBorrowDevice.DeviceName.Replace("'","\\'"))',
            '@Html.Raw(Model.QrBorrowDevice.Model.Replace("'","\\'"))');
        </text>
    }
});
function previewDeviceImport() {
    const file = document.getElementById('importDevFileInput').files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const parsed = parseCSV(e.target.result);
        if (parsed.length < 2) {
            document.getElementById('importDevFileError').textContent = 'CSV appears empty or has no data rows.';
            document.getElementById('importDevFileError').style.display = 'block'; return;
        }
        const headers  = parsed[0].map(h => h.trim().toLowerCase().replace(/\s+/g,'_'));
        const dataRows = parsed.slice(1);
        importDevRows  = []; let skipped = 0;
        dataRows.forEach(row => {
            const obj = {}; headers.forEach((h, i) => { obj[h] = (row[i] || '').trim(); });
            if (!obj.device_name) { skipped++; return; }
            importDevRows.push(obj);
        });
        const ready = importDevRows.length, total = dataRows.length;
        document.getElementById('importDevStep1').style.display = 'none';
        document.getElementById('importDevStep2').style.display = '';
        document.getElementById('importDevPreviewBtn').style.display = 'none';
        document.getElementById('importDevSubmitForm').style.display = '';
        document.getElementById('importDevRowsJson').value = JSON.stringify(importDevRows);
        document.getElementById('importDevSubmitBtn').textContent = `Import ${ready} Device${ready!==1?'s':''}`;
        document.getElementById('importDevSummaryBar').innerHTML =
